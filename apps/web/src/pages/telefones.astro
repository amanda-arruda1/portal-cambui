---
/**
 * Telefones úteis.
 *
 * Lista telefônica municipal além das secretarias (que já têm telefone,
 * e-mail e endereço no próprio cadastro — ver /secretarias): emergências,
 * escolas, unidades de saúde, assistência social, departamentos e diversos.
 * Migrada do site antigo em 2026-09-11, dado real, sem inventar nada.
 *
 * Mesmo padrão de /perguntas-frequentes: agrupado por categoria, acordeão
 * sem JavaScript (aqui, lista simples em vez de <details> — telefone é pra
 * escanear, não pra ler e recolher), filtro de texto por conveniência.
 */
import Base from '../layouts/Base.astro';
import Carreira from '../componentes/Carreira.astro';
import EstadoVazio from '../componentes/EstadoVazio.astro';
import TituloPagina from '../componentes/TituloPagina.astro';
import { telefonesUteis } from '../lib/conteudo';
import { linkTelefone, linkWhatsapp } from '../lib/formato';
import type { CategoriaTelefoneUtil, TelefoneUtil } from '../lib/tipos';

const { dados, indisponivel } = await telefonesUteis();

const ROTULO_CATEGORIA: Record<CategoriaTelefoneUtil, string> = {
  emergencias: 'Emergências',
  escolas_creches: 'Escolas e Creches',
  unidades_saude: 'Unidades de Saúde',
  assistencia_social: 'Assistência Social',
  departamentos: 'Departamentos',
  diversos: 'Diversos',
};
const ORDEM_CATEGORIA: CategoriaTelefoneUtil[] = ['emergencias', 'departamentos', 'unidades_saude', 'assistencia_social', 'escolas_creches', 'diversos'];

interface Grupo { categoria: CategoriaTelefoneUtil; rotulo: string; itens: TelefoneUtil[] }

const grupos = ORDEM_CATEGORIA
  .map((categoria) => ({ categoria, rotulo: ROTULO_CATEGORIA[categoria], itens: dados.filter((t) => t.categoria === categoria) }))
  .filter((g) => g.itens.length > 0);

---

<Base
  titulo="Telefones úteis"
  descricao="Telefones e e-mails de emergências, escolas, unidades de saúde, assistência social e departamentos da Prefeitura de Cambuí."
>
  <TituloPagina
    rotulo="Contato"
    titulo="Telefones úteis"
    chamada="Emergências, escolas, unidades de saúde, assistência social e departamentos — telefone, e-mail e endereço de cada um. Secretarias têm página própria em Estrutura administrativa."
    trilha={[{ rotulo: 'Telefones úteis' }]}
  />

  {
    dados.length === 0 ? (
      <Carreira numero="01" rotulo="Telefones" fundo="papel">
        <EstadoVazio indisponivel={indisponivel} assunto="telefones úteis" />
      </Carreira>
    ) : (
      <Carreira numero="01" rotulo={`${dados.length} contato${dados.length === 1 ? '' : 's'}`} fundo="papel">
        <div class="busca sem-impressao">
          <label for="filtro-tel" class="t-rotulo etiqueta">Filtrar por nome</label>
          <input
            type="search"
            id="filtro-tel"
            autocomplete="off"
            placeholder="Digite um nome, ex.: creche, CRAS, posto de saúde…"
          />
        </div>

        <nav aria-label="Categorias" class="sem-impressao">
          <ul class="filtros">
            {grupos.map((g) => (
              <li><a href={`#${g.categoria}`} class="atalho">{g.rotulo}</a></li>
            ))}
          </ul>
        </nav>

        <div id="tel-sem-resultado" class="vazio-filtro" hidden>
          <p class="t-sub">Nenhum contato encontrado.</p>
          <p class="t-lead">Tente outra palavra ou limpe o filtro.</p>
        </div>

        {
          grupos.map((grupo) => (
            <section id={grupo.categoria} class="grupo entra" data-grupo-tel>
              <h2 class="t-secao titulo-grupo">{grupo.rotulo}</h2>
              <ul class="lista">
                {grupo.itens.map((t) => (
                  <li class="item-tel" data-nome={t.nome.toLowerCase()}>
                    <p class="t-sub nome">{t.nome}</p>
                    {t.endereco && <p class="endereco">{t.endereco}</p>}
                    <div class="contatos">
                      {t.telefone && (
                        <a href={linkTelefone(t.telefone)} class="contato">
                          <svg width="15" height="15" viewBox="0 0 17 17" fill="none" aria-hidden="true"><path d="M17 1.42v2.84a.71.71 0 0 1-.71.71.71.71 0 0 1-.71-.71V2.44l-3.76 3.74a.71.71 0 0 1-1-.99l3.76-3.74h-1.82a.71.71 0 0 1 0-1.42h2.83A.71.71 0 0 1 17 1.42Z" fill="currentColor"/><path d="M5.72 8.52a12.3 12.3 0 0 0 2.76 2.76l.92-1.28a.71.71 0 0 1 .93-.2c.96.5 2.02.82 3.13.9a.71.71 0 0 1 .65.7v2.84a.71.71 0 0 1-.71.71C6.72 15.07 1.93 10.28 1.93 3.5a.71.71 0 0 1 .71-.71H5.48a.71.71 0 0 1 .7.65c.09 1.11.4 2.17.9 3.13a.71.71 0 0 1-.19.93l-1.17.92Z" fill="currentColor"/></svg>
                          {t.telefone}
                        </a>
                      )}
                      {t.telefone && linkWhatsapp(t.telefone) && (
                        <a href={linkWhatsapp(t.telefone)!} class="contato" target="_blank" rel="noopener noreferrer">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M17.6 6.32A7.85 7.85 0 0 0 12.05 4c-4.35 0-7.9 3.53-7.9 7.87 0 1.39.36 2.74 1.05 3.93L4 20l4.31-1.13a7.93 7.93 0 0 0 3.74.95h.01c4.34 0 7.88-3.53 7.88-7.87a7.8 7.8 0 0 0-2.34-5.63Zm-5.55 12.1h-.01a6.58 6.58 0 0 1-3.34-.91l-.24-.14-2.48.65.66-2.42-.16-.25a6.55 6.55 0 0 1-1-3.48c0-3.62 2.96-6.57 6.6-6.57a6.56 6.56 0 0 1 6.58 6.58c0 3.62-2.96 6.54-6.61 6.54Zm3.6-4.92c-.2-.1-1.17-.58-1.35-.64-.18-.07-.31-.1-.45.1-.13.19-.51.64-.63.78-.11.13-.23.15-.43.05-.2-.1-.83-.3-1.58-.97-.58-.52-.98-1.16-1.09-1.36-.11-.2-.01-.3.09-.4.09-.1.2-.24.3-.36.1-.12.13-.2.2-.34.06-.13.03-.25-.02-.35-.05-.1-.45-1.08-.61-1.48-.16-.38-.33-.33-.45-.34h-.38c-.13 0-.35.05-.53.25-.18.2-.7.68-.7 1.66s.72 1.93.82 2.06c.1.13 1.41 2.15 3.42 3.02.48.2.85.33 1.14.42.48.15.92.13 1.26.08.39-.06 1.17-.48 1.34-.94.16-.46.16-.86.11-.94-.05-.09-.18-.14-.38-.24Z" fill="currentColor"/></svg>
                          WhatsApp
                        </a>
                      )}
                      {t.email && (
                        <a href={`mailto:${t.email}`} class="contato">
                          <svg width="15" height="15" viewBox="0 0 20 16" fill="none" aria-hidden="true"><rect x="1" y="1" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="m2 2.5 8 6.5 8-6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          {t.email}
                        </a>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </Carreira>
    )
  }
</Base>

<script>
  const campo = document.getElementById('filtro-tel') as HTMLInputElement | null;
  const itens = Array.from(document.querySelectorAll<HTMLElement>('.item-tel'));
  const grupos = Array.from(document.querySelectorAll<HTMLElement>('[data-grupo-tel]'));
  const semResultado = document.getElementById('tel-sem-resultado');

  campo?.addEventListener('input', () => {
    const termo = campo.value.trim().toLowerCase();

    itens.forEach((item) => {
      item.hidden = !!termo && !(item.dataset.nome ?? '').includes(termo);
    });

    let algumVisivel = false;
    grupos.forEach((grupo) => {
      const visivel = Array.from(grupo.querySelectorAll<HTMLElement>('.item-tel')).some((i) => !i.hidden);
      grupo.hidden = !visivel;
      if (visivel) algumVisivel = true;
    });

    if (semResultado) semResultado.hidden = algumVisivel || !termo;
  });
</script>

<style>
  .busca { max-width: 28rem; margin-bottom: 1.75rem; }
  .etiqueta { display: block; color: var(--color-musgo); margin-bottom: 0.4rem; }
  .busca input {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    padding: 0.75rem 1rem;
    min-height: 2.75rem;
    border: 2px solid var(--color-serra);
    border-radius: 10px;
    background: var(--color-papel);
    color: var(--color-tinta);
  }

  .filtros { list-style: none; margin: 0 0 2rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .atalho {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.4rem 0.9rem;
    border: 2px solid color-mix(in srgb, var(--color-serra) 30%, transparent);
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-serra);
    font-weight: 600;
    font-size: 0.875rem;
  }
  .atalho:hover { background: var(--color-serra); color: var(--color-papel); border-color: var(--color-serra); }

  .vazio-filtro { padding: 1.5rem 0; color: var(--color-musgo); }
  .vazio-filtro .t-sub { color: var(--color-serra); }

  .grupo + .grupo { margin-top: 2.75rem; }
  .titulo-grupo { color: var(--color-serra); margin-bottom: 1rem; }

  .lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
  .item-tel {
    border: 1px solid var(--color-prata);
    border-radius: 12px;
    background: var(--color-papel);
    padding: 1rem 1.25rem;
  }
  .nome { font-family: var(--font-display); letter-spacing: -0.01em; }
  .endereco { margin-top: 0.3rem; color: var(--color-musgo); font-size: 0.875rem; }

  .contatos { margin-top: 0.6rem; display: grid; gap: 0.4rem; }
  .contato {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-serra);
    text-decoration: none;
    font-size: 0.9375rem;
    word-break: break-word;
  }
  .contato svg { flex: none; opacity: 0.8; }
  .contato:hover { color: var(--color-carmim); text-decoration: underline; }
</style>
