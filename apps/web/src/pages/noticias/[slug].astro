---
/**
 * Matéria.
 *
 * A coluna de leitura é fixa em 62ch: a largura da tela não é a largura do
 * texto. A ourela acompanha a rolagem à esquerda, ancorando a leitura e
 * amarrando a página interna ao mesmo sistema da home.
 */
import Base from '../../layouts/Base.astro';
import Carreira from '../../componentes/Carreira.astro';
import { arquivo } from '../../lib/directus';
import { noticiaPorSlug, noticiasRecentes } from '../../lib/conteudo';
import { data, iso, recorte, semHtml } from '../../lib/formato';
import { limpar } from '../../lib/sanitizar';

const { slug } = Astro.params;
const { dado: noticia } = await noticiaPorSlug(slug ?? '');
if (!noticia) return Astro.rewrite('/404');

const { dados: outras } = await noticiasRecentes(4);
const relacionadas = outras.filter((n) => n.slug !== noticia.slug).slice(0, 3);

const descricao = noticia.resumo ?? recorte(semHtml(noticia.conteudo), 160);
const capa = arquivo(noticia.imagem, { width: 1200, quality: 76, fit: 'cover', format: 'webp' });
---

<Base titulo={noticia.titulo} descricao={descricao} imagem={capa}>
  <article>
    <div class="carreira">
      <div class="ourela">
        <span class="fio fio-ourela" aria-hidden="true"></span>
        <div class="corpo">
          <nav aria-label="Você está aqui" class="trilha t-micro">
            <ol>
              <li><a href="/">Início</a></li>
              <li><span aria-hidden="true">›</span> <a href="/noticias">Notícias</a></li>
            </ol>
          </nav>

          <p class="t-rotulo meta">
            <time datetime={iso(noticia.data_publicacao)}>{data(noticia.data_publicacao)}</time>
            {noticia.secretaria && (
              <>
                {' · '}
                <a href={`/secretarias/${noticia.secretaria.slug}`}>{noticia.secretaria.nome}</a>
              </>
            )}
          </p>

          <h1 class="t-pagina">{noticia.titulo}</h1>
          {noticia.resumo && <p class="t-lead resumo">{noticia.resumo}</p>}
        </div>
      </div>
    </div>

    <div class="regua" aria-hidden="true"></div>

    <div class="carreira corpo-materia">
      <div class="ourela">
        <span class="fio fio-ourela" aria-hidden="true"></span>
        <div class="corpo">
          {capa && (
            <figure class="capa">
              <img
                src={capa}
                alt={noticia.imagem_descricao ?? ''}
                width="1200"
                height="675"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              {noticia.imagem_descricao && <figcaption class="t-micro">{noticia.imagem_descricao}</figcaption>}
            </figure>
          )}

          {noticia.conteudo && <div class="conteudo-rico texto" set:html={limpar(noticia.conteudo)} />}

          <div class="pe">
            <a href="/noticias" class="voltar"><span aria-hidden="true">←</span> <span class="fio-foco">Todas as notícias</span></a>
            {noticia.secretaria && (
              <a href={`/secretarias/${noticia.secretaria.slug}`} class="voltar">
                <span class="fio-foco">Falar com a {noticia.secretaria.nome}</span> <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    {
      relacionadas.length > 0 && (
        <Carreira numero="—" rotulo="Continue lendo" fundo="papel" acao={{ rotulo: 'Todas as notícias', destino: '/noticias' }}>
          <ul class="lista entra">
            {relacionadas.map((n) => (
              <li>
                <a href={`/noticias/${n.slug}`} class="linha-tarefa">
                  <span class="texto-rel">
                    <span class="t-rotulo meta">
                      <time datetime={iso(n.data_publicacao)}>{data(n.data_publicacao)}</time>
                    </span>
                    <span class="t-sub titulo-rel"><span class="fio-foco">{n.titulo}</span></span>
                  </span>
                  <svg class="seta" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                    <path d="M4 11h13M12 6l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </Carreira>
      )
    }
  </article>
</Base>

<style>
  .fio { min-height: 3rem; }
  .trilha ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; color: var(--color-musgo); }
  .trilha a { color: var(--color-serra); text-decoration: none; }
  .meta { color: var(--color-musgo); margin-top: 1.25rem; }
  .meta a { color: var(--color-carmim); text-decoration: none; }
  h1 { margin-top: 0.5rem; max-width: 22ch; }
  .resumo { margin-top: 1rem; max-width: var(--container-leitura); color: var(--color-musgo); }

  .corpo-materia { padding-top: 2rem; padding-bottom: 3rem; }
  .capa { margin: 0 0 2rem; }
  .capa img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-musgo) 18%, transparent);
  }
  .capa figcaption { margin-top: 0.6rem; color: var(--color-musgo); max-width: var(--container-leitura); }

  .pe {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-musgo) 28%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    max-width: var(--container-leitura);
  }
  .voltar { color: var(--color-serra); text-decoration: none; font-weight: 600; }

  .lista { list-style: none; margin: 1.25rem 0 0; padding: 0; }
  .texto-rel { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .titulo-rel { font-family: var(--font-display); letter-spacing: -0.01em; }
  .seta { color: var(--color-carmim); flex: none; }
</style>
