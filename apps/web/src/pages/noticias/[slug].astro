---
import Base from '../../layouts/Base.astro';
import { arquivo } from '../../lib/directus';
import { noticiaPorSlug } from '../../lib/conteudo';
import { data, iso, recorte } from '../../lib/formato';
// Segunda barreira: conteúdo também entra pelo painel do Directus, que não
// passa pelo formulário do painel de contribuição. Aqui nada escapa.
import { limpar } from '../../lib/sanitizar';

const { slug } = Astro.params;
const { dado: noticia } = await noticiaPorSlug(slug ?? '');

// Notícia despublicada ou slug inventado: 404 de verdade, com o status HTTP
// correto. Devolver 200 com "não encontrado" faria o Google indexar a página
// de erro.
if (!noticia) {
  return Astro.rewrite('/404');
}

const capa = arquivo(noticia.imagem, { width: 1200, quality: 80 });
const descricao = noticia.resumo ?? recorte(noticia.conteudo, 160);
---

<Base titulo={noticia.titulo} descricao={descricao} imagem={capa}>
  <article class="mx-auto max-w-6xl px-4 py-10">
    <nav aria-label="Você está aqui" class="nao-imprimir text-sm text-grafite">
      <a href="/" class="underline">Início</a> ›
      <a href="/noticias" class="underline">Notícias</a>
    </nav>

    <header class="mt-4">
      <h1 class="text-3xl font-bold text-azul-escuro sm:text-4xl">{noticia.titulo}</h1>
      <p class="mt-3 text-grafite">
        Publicado em <time datetime={iso(noticia.data_publicacao)}>{data(noticia.data_publicacao)}</time>
        {
          noticia.secretaria && (
            <>
              {' '}por{' '}
              <a href={`/secretarias/${noticia.secretaria.slug}`} class="underline">
                {noticia.secretaria.nome}
              </a>
            </>
          )
        }
      </p>
    </header>

    {
      capa && (
        <figure class="mt-6">
          <img
            src={capa}
            alt={noticia.imagem_descricao ?? ''}
            width="1200"
            height="675"
            class="w-full rounded-lg"
          />
          {noticia.imagem_descricao && (
            <figcaption class="mt-2 text-sm text-grafite">{noticia.imagem_descricao}</figcaption>
          )}
        </figure>
      )
    }

    {
      noticia.resumo && (
        <p class="mt-6 max-w-(--container-leitura) text-lg font-medium text-grafite">{noticia.resumo}</p>
      )
    }

    {
      /* O corpo vem do editor do Directus, onde só entra gente autenticada da
         prefeitura com fluxo de aprovação. É HTML confiável por processo, não
         por sanitização no navegador. */
      noticia.conteudo && <div class="conteudo-rico mt-6" set:html={limpar(noticia.conteudo)} />
    }

    <p class="nao-imprimir mt-10">
      <a href="/noticias" class="font-semibold text-azul underline">← Voltar para as notícias</a>
    </p>
  </article>
</Base>
