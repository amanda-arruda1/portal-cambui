---
/**
 * "Publicar nova licitação".
 *
 * Não mostra formulário: CRIA O RASCUNHO na hora e leva o servidor ao editor.
 *
 * É a resposta ao requisito de rascunho automático, e a resposta boa: guardar
 * em localStorage protege contra a aba fechar, mas não contra o computador
 * desligar, a sessão cair ou a pessoa continuar de outra máquina. Rascunho no
 * banco desde o primeiro clique protege contra os quatro.
 *
 * O número é sugerido a partir do último do ano — e continua editável, porque
 * a numeração é do setor, não do sistema.
 */
import { criar, gerarSlug, listarPainel } from '../../../lib/painel/licitacoes.ts';

const sessao = Astro.locals.sessao!;
const ano = new Date().getFullYear();

const existentes = await listarPainel(
  sessao,
  new URLSearchParams({ limit: '1', sort: '-numero', fields: 'numero', 'filter[ano][_eq]': String(ano) }).toString(),
);
const proximo = (existentes.ok && existentes.dados[0]?.numero ? Number(existentes.dados[0].numero) : 0) + 1;

const r = await criar(sessao, {
  status: 'rascunho',
  situacao: 'publicada',
  numero_processo: `RASCUNHO-${Date.now().toString(36).toUpperCase()}`,
  numero: proximo,
  ano,
  slug: `${gerarSlug('pregao_eletronico', proximo)}-rascunho-${Date.now().toString(36)}`,
  modalidade: 'pregao_eletronico',
  forma: 'eletronica',
  criterio_julgamento: 'menor_preco',
  modo_disputa: 'aberto',
  objeto_resumo: 'Rascunho — descreva o objeto',
  data_publicacao: new Date().toISOString(),
});

if (!r.ok) {
  return new Response(`Não foi possível criar o rascunho: ${r.motivo}`, {
    status: r.status, headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

console.info(`[licitacoes] ${sessao.usuario.email} abriu o rascunho ${r.dados.id}`);
return Astro.redirect(`/painel/licitacoes/${r.dados.id}?novo=1`, 303);
---
