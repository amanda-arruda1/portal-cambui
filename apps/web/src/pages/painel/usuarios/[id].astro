---
/**
 * Editar uma pessoa: função, secretaria, situação e redefinição de senha.
 *
 * Não há exclusão. Conta de servidor público que produziu conteúdo é registro:
 * quem sai vira "Arquivado", que bloqueia o acesso e preserva a autoria dos
 * itens que a pessoa escreveu.
 */
import Painel from '../../../layouts/Painel.astro';
import { listarSecretarias } from '../../../lib/painel/cms.ts';
import {
  atualizarPessoa,
  gerarSenha,
  listarPapeis,
  obterPessoa,
  ordenarPapeis,
  PAPEIS_ATRIBUIVEIS,
  PAPEL_ADMIN,
  SITUACOES,
} from '../../../lib/painel/usuarios.ts';
import { dataHora } from '../../../lib/formato.ts';

const sessao = Astro.locals.sessao!;
if (sessao.usuario.papel !== PAPEL_ADMIN) return Astro.rewrite('/404');

const id = Astro.params.id ?? '';
const ehVoceMesmo = id === sessao.usuario.id;

let aviso: { tipo: 'ok' | 'erro'; texto: string } | null = null;
let senhaNova: string | null = null;
let erros: Record<string, string> = {};

const [papeisResp, secretariasResp] = await Promise.all([listarPapeis(sessao), listarSecretarias(sessao)]);
const papeis = papeisResp.ok ? papeisResp.dados : [];
const secretarias = secretariasResp.ok ? secretariasResp.dados : [];
const adminId = papeis.find((p) => p.name === PAPEL_ADMIN)?.id ?? null;

// Quem já era administrador não precisa reconfirmar a cada gravação — a
// confirmação existe para a PROMOÇÃO, não para salvar um telefone. Por isso o
// estado anterior vem do servidor, e só quando há envio.
const antes = Astro.request.method === 'POST' ? await obterPessoa(sessao, id) : null;
const eraAdmin = antes?.ok ? antes.dados.papel === PAPEL_ADMIN : false;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const pega = (n: string) => String(f.get(n) ?? '').trim();

  if (pega('acao') === 'redefinir_senha') {
    const senha = gerarSenha();
    const r = await atualizarPessoa(sessao, id, { senha });
    if (r.ok) {
      senhaNova = senha;
      aviso = { tipo: 'ok', texto: 'Senha redefinida.' };
      console.info(`[usuarios] ${sessao.usuario.email} redefiniu a senha de ${id}`);
    } else {
      aviso = { tipo: 'erro', texto: r.motivo };
    }
  } else {
    const papelId = pega('papel') || null;
    const nomeDoPapel = papeis.find((p) => p.id === papelId)?.name ?? '';
    const secretaria = pega('secretaria') || null;
    const situacao = pega('situacao') || 'active';

    // Trava contra ficar de fora do próprio sistema: se a única conta que
    // administra deixar de administrar, ninguém mais cadastra ninguém — e o
    // painel do Directus, que resolveria isso, não é alcançável.
    if (ehVoceMesmo && nomeDoPapel !== PAPEL_ADMIN) {
      erros.papel = 'Você não pode retirar a própria função de administrador — ficaria sem quem gerencie o portal.';
    }
    if (ehVoceMesmo && situacao !== 'active') {
      erros.situacao = 'Você não pode desativar a própria conta.';
    }
    // Promover a administrador dá acesso total ao CMS, inclusive o de rebaixar
    // quem promoveu. Mesmo gesto deliberado exigido no cadastro.
    if (nomeDoPapel === PAPEL_ADMIN && !eraAdmin && f.get('confirmo_admin') !== 'sim') {
      erros.papel =
        'Para tornar esta pessoa administradora, marque a confirmação — ela passa a ter acesso total ao portal.';
    }
    if (nomeDoPapel === 'Redator de secretaria' && !secretaria) {
      erros.secretaria = 'Redator precisa de uma secretaria — sem ela a fila fica vazia para sempre.';
    }

    if (Object.keys(erros).length === 0) {
      const r = await atualizarPessoa(sessao, id, {
        nome: pega('nome'),
        sobrenome: pega('sobrenome'),
        papelId,
        secretaria,
        situacao,
      });
      aviso = r.ok ? { tipo: 'ok', texto: 'Alterações salvas.' } : { tipo: 'erro', texto: r.motivo };
      if (r.ok) console.info(`[usuarios] ${sessao.usuario.email} alterou ${id} para "${nomeDoPapel}"`);
    }
  }
}

const resultado = await obterPessoa(sessao, id);
if (!resultado.ok) {
  return Astro.rewrite(`/painel/usuarios`);
}
const pessoa = resultado.dados;

const campo = 'mt-1 w-full rounded-md border border-prata bg-papel px-3 py-2';
const partes = pessoa.nome.split(' ');
const primeiro = partes[0] ?? '';
const resto = partes.slice(1).join(' ');
---

<Painel titulo={pessoa.nome} sessao={sessao}>
  <nav class="text-sm text-grafite">
    <a href="/painel" class="text-azul underline">Fila</a> <span aria-hidden="true">›</span>
    <a href="/painel/usuarios" class="text-azul underline">Pessoas</a>
    <span aria-hidden="true">›</span> Editar
  </nav>

  <h1 class="mt-2 text-2xl font-bold text-azul-escuro">{pessoa.nome}</h1>
  <p class="mt-1 text-grafite">
    {pessoa.email}
    {ehVoceMesmo && <span class="ml-2 rounded-full border border-azul bg-azul-claro px-2 py-0.5 text-sm text-azul-escuro">é você</span>}
  </p>
  <p class="mt-1 text-sm text-grafite">
    Último acesso: {pessoa.ultimoAcesso ? dataHora(pessoa.ultimoAcesso) : 'nunca entrou'} ·
    Verificação em duas etapas: {pessoa.temSegundoFator ? 'configurada' : 'não configurada'}
  </p>

  {
    aviso && (
      <div
        role={aviso.tipo === 'erro' ? 'alert' : 'status'}
        class={`mt-4 rounded-md border-l-4 bg-papel p-4 ${aviso.tipo === 'erro' ? 'border-vermelho text-vermelho' : 'border-verde text-verde-texto'}`}
      >
        {aviso.texto}
      </div>
    )
  }

  {
    senhaNova && (
      <div class="mt-4 rounded-lg border-l-4 border-verde bg-papel p-5">
        <p class="text-grafite">Nova senha — entregue por um canal confiável. Não aparece de novo:</p>
        <p class="mt-2 font-mono text-lg font-bold select-all">{senhaNova}</p>
      </div>
    )
  }

  {
    pessoa.papel === 'Publicador' && !pessoa.temSegundoFator && (
      <div role="alert" class="mt-4 rounded-md border-l-4 border-vermelho bg-papel p-4 text-vermelho">
        Esta conta é Publicador e não tem verificação em duas etapas. A política exige o segundo
        fator, então ela <strong>não consegue entrar</strong>. Coloque a pessoa como Revisor até que
        o segundo fator possa ser configurado.
      </div>
    )
  }

  <form method="post" class="mt-6 grid gap-5 rounded-lg border border-prata bg-papel p-6 sm:grid-cols-2">
    <div>
      <label for="nome" class="block font-semibold text-azul-escuro">Nome</label>
      <input id="nome" name="nome" type="text" value={primeiro} class={campo} />
    </div>
    <div>
      <label for="sobrenome" class="block font-semibold text-azul-escuro">Sobrenome</label>
      <input id="sobrenome" name="sobrenome" type="text" value={resto} class={campo} />
    </div>

    <div>
      <label for="papel" class="block font-semibold text-azul-escuro">Função</label>
      <select
        id="papel"
        name="papel"
        class={campo}
        disabled={ehVoceMesmo}
        data-papel
        data-admin={adminId ?? ''}
      >
        <option value="">— sem função —</option>
        {
          ordenarPapeis(
            papeis.filter(
              (p) => (PAPEIS_ATRIBUIVEIS as readonly string[]).includes(p.name) || p.id === pessoa.papelId,
            ),
          ).map((p) => (
            <option value={p.id} selected={pessoa.papelId === p.id}>
              {p.name === PAPEL_ADMIN ? 'Administrador do portal (acesso total)' : p.name}
            </option>
          ))
        }
      </select>
      {ehVoceMesmo && <input type="hidden" name="papel" value={pessoa.papelId ?? ''} />}
      {erros.papel && <p class="mt-1 text-sm font-semibold text-vermelho">{erros.papel}</p>}
      {ehVoceMesmo && (
        <p class="mt-1 text-sm text-grafite">
          A própria função não se altera aqui — é a trava que impede o portal de ficar sem
          administrador.
        </p>
      )}
    </div>

    {!ehVoceMesmo && pessoa.papel !== PAPEL_ADMIN && (
      <div class="sm:col-span-2" data-caixa-admin hidden={!erros.papel}>
        <div class="rounded-md border-l-4 border-vermelho bg-papel-suave p-4">
          <p class="font-semibold text-vermelho">Promover a administrador do portal.</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-grafite">
            <li>Passa a enxergar e alterar tudo no CMS, sem passar pelo fluxo editorial.</li>
            <li>Pode criar e remover administradores — inclusive retirar a sua função.</li>
            <li>
              A função de administrador não exige verificação em duas etapas: peça à pessoa que
              cadastre o autenticador em <strong>Minha conta</strong>.
            </li>
          </ul>
          <label class="mt-3 flex items-start gap-2 font-semibold text-azul-escuro">
            <input type="checkbox" name="confirmo_admin" value="sim" class="mt-1" />
            <span>Confirmo a promoção.</span>
          </label>
        </div>
      </div>
    )}

    <div>
      <label for="secretaria" class="block font-semibold text-azul-escuro">Secretaria</label>
      <select id="secretaria" name="secretaria" class={campo}>
        <option value="">— nenhuma —</option>
        {secretarias.map((s) => (
          <option value={s.id} selected={pessoa.secretaria === s.id}>{s.nome}</option>
        ))}
      </select>
      {erros.secretaria && <p class="mt-1 text-sm font-semibold text-vermelho">{erros.secretaria}</p>}
    </div>

    <div>
      <label for="situacao" class="block font-semibold text-azul-escuro">Situação</label>
      <select id="situacao" name="situacao" class={campo} disabled={ehVoceMesmo}>
        {SITUACOES.map((s) => (
          <option value={s.valor} selected={pessoa.situacao === s.valor}>{s.rotulo}</option>
        ))}
      </select>
      {ehVoceMesmo && <input type="hidden" name="situacao" value={pessoa.situacao} />}
      {erros.situacao && <p class="mt-1 text-sm font-semibold text-vermelho">{erros.situacao}</p>}
      <p class="mt-1 text-sm text-grafite">
        Não há exclusão: quem sai vira <strong>Arquivado</strong>, o que bloqueia o acesso e preserva
        a autoria do que a pessoa escreveu.
      </p>
    </div>

    <div class="sm:col-span-2 flex flex-wrap gap-3">
      <button type="submit" class="rounded-md bg-azul px-5 py-2 font-semibold text-papel hover:bg-azul-escuro">
        Salvar alterações
      </button>
      <a href="/painel/usuarios" class="rounded-md border border-prata px-5 py-2 font-semibold text-grafite hover:border-azul hover:text-azul">
        Voltar
      </a>
    </div>
  </form>

  <form method="post" class="mt-6 rounded-lg border border-prata bg-papel p-6" data-confirmar="Gerar uma senha nova? A senha atual deixa de funcionar imediatamente.">
    <h2 class="font-bold text-azul-escuro">Redefinir senha</h2>
    <p class="mt-1 text-grafite">
      Gera uma senha nova e mostra uma única vez. Use quando a pessoa perder o acesso.
    </p>
    <input type="hidden" name="acao" value="redefinir_senha" />
    <button type="submit" class="mt-3 rounded-md border border-vermelho px-4 py-2 font-semibold text-vermelho hover:bg-vermelho hover:text-papel">
      Gerar nova senha
    </button>
  </form>
</Painel>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirmar]').forEach((formulario) => {
    formulario.addEventListener('submit', (evento) => {
      const pergunta = formulario.dataset.confirmar;
      if (pergunta && !window.confirm(pergunta)) evento.preventDefault();
    });
  });

  /* A caixa de promoção a administrador só aparece quando a função escolhida é
   * a dele. Sem JavaScript ela vem escondida, mas o servidor recusa o envio e a
   * devolve visível com o erro — o caminho não depende disto. */
  const select = document.querySelector<HTMLSelectElement>('select[data-papel]');
  const caixa = document.querySelector<HTMLElement>('[data-caixa-admin]');
  const marca = caixa?.querySelector<HTMLInputElement>('input[name="confirmo_admin"]');

  if (select && caixa) {
    const adminId = select.dataset.admin || '';
    const rever = () => {
      const ehAdmin = adminId !== '' && select.value === adminId;
      caixa.hidden = !ehAdmin;
      if (!ehAdmin && marca) marca.checked = false;
    };
    select.addEventListener('change', rever);
    rever();
  }
</script>
