---
/**
 * Primeira tela depois de entrar: a fila de trabalho.
 *
 * Mostra, por coleção, quantos itens estão em cada situação — com a fila do
 * papel de quem entrou em destaque. Herda a regra do portal público: coleção
 * ausente ou permissão não concedida degrada o quadro, não derruba a tela.
 * Sem isso o painel só existiria depois do esquema aplicado.
 */
import Painel from '../../layouts/Painel.astro';
import { COLECOES_EDITAVEIS, ROTULO, contarPorSituacao, type ColecaoEditavel } from '../../lib/painel/cms.ts';
import { APARENCIA, ORDEM_DA_FILA, filaDoPapel } from '../../lib/painel/fluxo.ts';
import { listarPainel } from '../../lib/painel/licitacoes.ts';
import { PAPEIS_DIARIO, PAPEIS_LICITACOES, PAPEIS_OBRAS } from '../../lib/painel/sessao.ts';

const sessao = Astro.locals.sessao!;
const fila = filaDoPapel(sessao.usuario.papel);

/* Diário Oficial, Licitações e Obras públicas não são coleções da fila — têm
   tela e fluxo próprios (ver PAPEIS_* em sessao.ts) — mas ficavam SÓ no menu
   do topo, sem nenhum atalho aqui na tela em que a pessoa efetivamente entra
   primeiro. Foi assim que 697 licitações já cadastradas passaram
   despercebidas por quem cuida do portal. */
const subsistemas = [
  { rotulo: 'Diário Oficial', destino: '/painel/diario', papeis: PAPEIS_DIARIO },
  { rotulo: 'Licitações', destino: '/painel/licitacoes', papeis: PAPEIS_LICITACOES, novo: { rotulo: 'Publicar nova licitação', destino: '/painel/licitacoes/nova' } },
  { rotulo: 'Obras públicas', destino: '/painel/obras', papeis: PAPEIS_OBRAS },
].filter((s) => s.papeis.includes(sessao.usuario.papel ?? ''));

const rascunhosLicitacoes = subsistemas.some((s) => s.rotulo === 'Licitações')
  ? await (async () => {
      const r = await listarPainel(sessao, new URLSearchParams({ 'filter[status][_eq]': 'rascunho', aggregate: JSON.stringify({ count: 'id' }) }).toString());
      return r.ok ? Number((r.dados as any)[0]?.count?.id ?? 0) : null;
    })()
  : null;

const quadros = await Promise.all(
  COLECOES_EDITAVEIS.map(async (colecao: ColecaoEditavel) => {
    const r = await contarPorSituacao(sessao, colecao);
    return {
      colecao,
      rotulo: ROTULO[colecao],
      contagem: r.ok ? r.dados : null,
      motivo: r.ok ? null : r.motivo,
    };
  }),
);

const nadaResponde = quadros.every((q) => q.contagem === null);
const pendentes = quadros.reduce(
  (total, q) => total + fila.situacoes.reduce((s, situacao) => s + (q.contagem?.[situacao] ?? 0), 0),
  0,
);
---

<Painel titulo="Fila" sessao={sessao}>
  <h1 class="text-2xl font-bold text-azul-escuro">{fila.titulo}</h1>
  <p class="mt-1 text-grafite">
    {
      nadaResponde
        ? 'O sistema de conteúdo ainda não respondeu.'
        : pendentes === 0
          ? 'Nada aguardando você no momento.'
          : `${pendentes} ${pendentes === 1 ? 'item aguarda' : 'itens aguardam'} sua ação.`
    }
  </p>

  {
    nadaResponde && (
      <div role="status" class="mt-6 rounded-lg border-l-4 border-trigo bg-papel p-5">
        <p class="font-semibold text-azul-escuro">O painel está no ar, mas o conteúdo ainda não.</p>
        <p class="mt-2 text-grafite">
          Nenhuma coleção respondeu. Ou o esquema do CMS ainda não foi aplicado, ou sua função
          não tem permissão de leitura. A página <a class="text-azul underline" href="/painel/estado">estado do sistema</a>{' '}
          mostra o diagnóstico.
        </p>
      </div>
    )
  }

  {
    subsistemas.length > 0 && (
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          subsistemas.map((s) => (
            <section class="rounded-lg border-2 border-azul bg-papel p-5">
              <h2 class="font-bold text-azul-escuro">
                <a href={s.destino} class="underline decoration-prata underline-offset-4 hover:decoration-azul">
                  {s.rotulo}
                </a>
              </h2>
              <p class="mt-1 text-sm text-grafite">Tela e fluxo próprios — fora da fila de coleções abaixo.</p>
              {s.rotulo === 'Licitações' && rascunhosLicitacoes !== null && rascunhosLicitacoes > 0 && (
                <p class="mt-2 text-sm">
                  <span class="font-semibold text-trigo">{rascunhosLicitacoes}</span> em rascunho, ainda invisível para o cidadão
                </p>
              )}
              {s.novo && (
                <a href={s.novo.destino} class="mt-3 inline-block rounded-md bg-azul px-3 py-1.5 text-sm font-semibold text-papel hover:bg-azul-escuro">
                  + {s.novo.rotulo}
                </a>
              )}
            </section>
          ))
        }
      </div>
    )
  }

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      quadros.map((q) => (
        <section class="rounded-lg border border-prata bg-papel p-5">
          <h2 class="font-bold text-azul-escuro">
            <a href={`/painel/${q.colecao}`} class="underline decoration-prata underline-offset-4 hover:decoration-azul">
              {q.rotulo}
            </a>
          </h2>

          {q.contagem === null ? (
            <p class="mt-3 text-sm text-grafite">{q.motivo}</p>
          ) : Object.keys(q.contagem).length === 0 ? (
            <p class="mt-3 text-sm text-grafite">Nenhum item cadastrado ainda.</p>
          ) : (
            <ul class="mt-3 space-y-1">
              {ORDEM_DA_FILA.filter((s) => (q.contagem?.[s] ?? 0) > 0).map((s) => (
                <li class="flex items-center justify-between gap-2 text-sm">
                  <span
                    class={`inline-block rounded-full border px-2 py-0.5 ${APARENCIA[s].classe} ${
                      fila.situacoes.includes(s) ? 'font-semibold' : ''
                    }`}
                  >
                    {APARENCIA[s].rotulo}
                  </span>
                  <span class="font-mono text-grafite">{q.contagem?.[s]}</span>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>
</Painel>
