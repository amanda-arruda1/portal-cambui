 */
import Base from '../../layouts/Base.astro';
import TituloPagina from '../../componentes/TituloPagina.astro';
import Listagem from '../../componentes/licitacoes/Listagem.astro';
---

<Base
  titulo="Licitações"
  descricao="Editais, avisos e resultados das licitações e contratações diretas da Prefeitura Municipal de Cambuí. Busque por objeto, modalidade e prazo."
>
  <TituloPagina
    rotulo="Licitações e contratações"
