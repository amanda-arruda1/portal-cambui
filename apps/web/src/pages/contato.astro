---
import Base from '../layouts/Base.astro';
import Carreira from '../componentes/Carreira.astro';
import LinhaTarefa from '../componentes/LinhaTarefa.astro';
import TituloPagina from '../componentes/TituloPagina.astro';
import { secretarias } from '../lib/conteudo';
import { linkMapa, linkTelefone, linkWhatsapp } from '../lib/formato';
import {
  EMAIL_CONTATO,
  ENDERECO,
  HORARIO_ATENDIMENTO,
  MUNICIPIO,
  TELEFONES,
  TEM_CONTATO,
} from '../dados/instituicional';

const { dados } = await secretarias();
const comContato = dados.filter((s) => s.telefone || s.email || s.endereco);
const mapaSede = ENDERECO ? linkMapa(`${ENDERECO.logradouro}, ${ENDERECO.numero} – ${ENDERECO.bairro} – ${ENDERECO.cidade}/${ENDERECO.uf}`) : null;
---

<Base
  titulo="Contato"
  descricao={`Canais de atendimento da ${MUNICIPIO.nomeCompleto}.`}
>
  <TituloPagina
    rotulo="Contato"
    titulo="Como falar com a Prefeitura"
    chamada="A sede do município e o contato direto de cada secretaria."
    trilha={[{ rotulo: 'Contato' }]}
  />

  <Carreira numero="01" rotulo="Sede da Prefeitura" fundo="papel">
    {
      TEM_CONTATO ? (
        <address class="sede entra">
          {ENDERECO && (
            <p class="endereco">
              {ENDERECO.logradouro}, {ENDERECO.numero} — {ENDERECO.bairro}<br />
              {ENDERECO.cidade}/{ENDERECO.uf} — CEP {ENDERECO.cep}
              {mapaSede && (
                <>
                  <br />
                  <a href={mapaSede} class="mapa" target="_blank" rel="noopener noreferrer">Ver no mapa</a>
                </>
              )}
            </p>
          )}
          {TELEFONES.length > 0 && (
            <p class="contatos">
              {TELEFONES.map((t) => {
                const rotuloTexto = t.rotulo ? `${t.rotulo}: ${t.numero}` : t.numero;
                const whatsapp = linkWhatsapp(t.numero);
                return whatsapp ? (
                  <a href={whatsapp} target="_blank" rel="noopener noreferrer">
                    <span class="fio-foco">{rotuloTexto}</span>
                  </a>
                ) : (
                  <a href={linkTelefone(t.numero)}>
                    <span class="fio-foco">{rotuloTexto}</span>
                  </a>
                );
              })}
            </p>
          )}
          {EMAIL_CONTATO && (
            <p class="contatos">
              <a href={`mailto:${EMAIL_CONTATO}`}><span class="fio-foco">{EMAIL_CONTATO}</span></a>
            </p>
          )}
          {HORARIO_ATENDIMENTO && <p class="horario">{HORARIO_ATENDIMENTO}</p>}
        </address>
      ) : (
        <p class="pendente">
          Os canais oficiais de atendimento da Prefeitura estão sendo publicados neste portal.
          O atendimento presencial na sede do município continua normalmente.
        </p>
      )
    }
  </Carreira>

  {
    comContato.length > 0 && (
      <Carreira numero="02" rotulo="Secretarias">
        <ul class="lista entra">
          {comContato.map((s) => (
            <li>
              <LinhaTarefa
                tarefa={{
                  rotulo: s.nome,
                  detalhe: [s.telefone, s.email, s.endereco].filter(Boolean).join(' · '),
                  destino: `/secretarias/${s.slug}`,
                }}
              />
            </li>
          ))}
        </ul>
      </Carreira>
    )
  }
</Base>

<style>
  .sede { max-width: var(--container-leitura); }
  .endereco { line-height: 1.6; }
  .mapa { color: var(--color-serra); font-weight: 600; text-decoration: none; font-size: 0.9375rem; }
  .mapa:hover { text-decoration: underline; }
  .contatos { margin-top: 0.75rem; font-weight: 600; }
  .contatos a { color: var(--color-serra); text-decoration: none; }
  .horario { margin-top: 0.75rem; color: var(--color-musgo); }
  .pendente { max-width: var(--container-leitura); color: var(--color-musgo); }
  .lista { list-style: none; margin: 1.25rem 0 0; padding: 0; }
</style>
