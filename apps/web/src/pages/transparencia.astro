---
import Base from '../layouts/Base.astro';
import TituloPagina from '../componentes/TituloPagina.astro';
import { linksUteis } from '../lib/conteudo';
import { SISTEMAS_EXTERNOS } from '../dados/instituicional';

/**
 * DECISÃO DE PROJETO: o portal NÃO reimplementa o Portal da Transparência.
 * A transparência é obrigação da Lei Complementar 131/2009 e da Lei 12.527/2011
 * atendida pelo sistema contábil homologado do município — reconstruí-la aqui
 * significaria duplicar dado financeiro, que é a pior coisa que se pode fazer
 * com dado financeiro. Esta página é um índice de acesso: leva o cidadão ao
 * sistema oficial em um clique.
 */
const { dados } = await linksUteis();

// Links cadastrados no CMS têm prioridade; SISTEMAS_EXTERNOS é a lista fixa de
// partida, usada enquanto o CMS não estiver alimentado.
const doCms = dados.map((l) => ({ nome: l.nome, url: l.url, descricao: l.descricao ?? '' }));
const links = doCms.length > 0 ? doCms : SISTEMAS_EXTERNOS;
---

<Base
  titulo="Transparência"
  descricao="Acesso ao Portal da Transparência, ao e-SIC e aos demais sistemas oficiais do Município de Cambuí."
>
  <TituloPagina
    titulo="Transparência e acesso à informação"
    descricao="Onde consultar receitas, despesas, contratos e pedidos de informação."
  />

  <div class="mx-auto max-w-6xl px-4 py-10">
    {
      links.length > 0 ? (
        <ul class="grid gap-4 sm:grid-cols-2">
          {links.map((link) => (
            <li class="rounded-lg border border-prata p-5">
              <h2 class="text-lg font-bold text-azul-escuro">
                <a href={link.url} rel="noopener noreferrer" target="_blank" class="underline">
                  {link.nome}
                  <span class="sr-only"> (abre em nova aba, site externo)</span>
                  <span aria-hidden="true"> ↗</span>
                </a>
              </h2>
              {link.descricao && <p class="mt-2 text-grafite">{link.descricao}</p>}
            </li>
          ))}
        </ul>
      ) : (
        /* Sem inventar URL: enquanto a prefeitura não confirmar os endereços
           dos sistemas oficiais, a página diz a verdade em vez de apontar para
           um link quebrado. */
        <div class="rounded-lg border border-prata bg-papel-suave p-8">
          <p class="text-lg font-semibold text-azul-escuro">Endereços em confirmação</p>
          <p class="mt-2 max-w-(--container-leitura) text-grafite">
            Os links para o Portal da Transparência, o Diário Oficial e o e-SIC estão sendo
            confirmados junto aos sistemas oficiais do município e serão publicados aqui.
            Enquanto isso, o atendimento presencial na sede da prefeitura segue disponível
            para pedidos de acesso à informação.
          </p>
        </div>
      )
    }

    <section class="mt-10 max-w-(--container-leitura)">
      <h2 class="text-2xl font-bold text-azul-escuro">Pedido de acesso à informação</h2>
      <p class="mt-3 text-grafite">
        Qualquer pessoa pode solicitar informações públicas ao município, sem precisar
        justificar o pedido, conforme a Lei nº 12.527/2011 (Lei de Acesso à Informação).
        O prazo de resposta é de até 20 dias, prorrogável por mais 10 mediante justificativa.
      </p>
    </section>
  </div>
</Base>
