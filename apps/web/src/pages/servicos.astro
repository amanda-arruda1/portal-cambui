---
/**
 * Catálogo de serviços POR NECESSIDADE.
 *
 * A inversão que o briefing pede e que quase nenhum portal de prefeitura faz:
 * o cidadão não sabe — nem deveria precisar saber — qual secretaria cuida do
 * quê. Ele sabe o que precisa. Então o índice é "Minha casa e meu bairro",
 * não "Secretaria de Obras e Serviços Urbanos".
 *
 * Os serviços cadastrados no CMS entram DEPOIS do catálogo curado, porque o
 * catálogo é o caminho curto e o CMS é o inventário completo.
 */
import Base from '../layouts/Base.astro';
import TituloPagina from '../componentes/TituloPagina.astro';
import Carreira from '../componentes/Carreira.astro';
import LinhaTarefa from '../componentes/LinhaTarefa.astro';
import Coleta from '../componentes/Coleta.astro';
import { servicos } from '../lib/conteudo';
import { NECESSIDADES } from '../dados/cidade';

const { dados: doCms, indisponivel } = await servicos();
const foco = Astro.url.searchParams.get('necessidade');
---

<Base
  titulo="Serviços ao cidadão"
  descricao="Serviços da Prefeitura de Cambuí organizados pelo que você precisa resolver: casa e bairro, saúde, educação, trabalho, documentos e transparência."
>
  <TituloPagina
    rotulo="Serviços"
    titulo="O que você precisa resolver?"
    chamada="Organizado pela sua necessidade, não pelo organograma da Prefeitura. Se você não souber a qual secretaria pertence o que procura, tudo bem — não precisa saber."
    trilha={[{ rotulo: 'Serviços' }]}
  />

  <!-- Índice: dois cliques até qualquer serviço, um até os mais buscados. -->
  <div class="carreira indice sem-impressao">
    <div class="ourela">
      <span aria-hidden="true"></span>
      <nav aria-label="Categorias de serviço" class="corpo">
        <ul>
          {NECESSIDADES.map((n) => (
            <li><a href={`#${n.chave}`} class:list={['atalho', foco === n.chave && 'ativo']}>{n.titulo}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  {
    NECESSIDADES.map((n, i) => (
      <Carreira
        numero={String(i + 1).padStart(2, '0')}
        rotulo={n.titulo}
        titulo={n.chamada}
        fundo={i % 2 === 0 ? 'papel' : 'neblina'}
        id={n.chave}
      >
        <ul class="lista entra">
          {n.tarefas.map((t) => (
            <li><LinhaTarefa tarefa={t} /></li>
          ))}
        </ul>

        {n.chave === 'casa' && (
          <div id="coleta" class="bloco-coleta">
            <h3 class="t-sub">Coleta de lixo por bairro</h3>
            <Coleta />
          </div>
        )}
      </Carreira>
    ))
  }

  <!-- Inventário completo, alimentado pelas secretarias. -->
  <Carreira numero="07" rotulo="Todos os serviços cadastrados" fundo="papel">
    {
      indisponivel || doCms.length === 0 ? (
        <p class="vazio">
          As secretarias ainda estão cadastrando o inventário completo. Os caminhos acima já levam
          aos serviços que hoje funcionam.
        </p>
      ) : (
        <ul class="lista entra">
          {doCms.map((s) => (
            <li>
              <LinhaTarefa
                tarefa={{
                  rotulo: s.nome,
                  detalhe: [s.categoria, s.secretaria?.nome].filter(Boolean).join(' · ') || 'Serviço municipal',
                  destino: s.url_externa ?? `/servicos#${s.slug}`,
                  externo: Boolean(s.url_externa),
                }}
              />
            </li>
          ))}
        </ul>
      )
    }
  </Carreira>
</Base>

<style>
  .indice { padding-bottom: 1rem; }
  .indice ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .atalho {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 2px solid color-mix(in srgb, var(--color-serra) 30%, transparent);
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-serra);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .atalho:hover, .atalho.ativo { background: var(--color-serra); color: var(--color-papel); border-color: var(--color-serra); }

  .lista { list-style: none; margin: 1.25rem 0 0; padding: 0; }
  .vazio { margin-top: 1.25rem; color: var(--color-musgo); max-width: var(--container-leitura); }
  .bloco-coleta { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 2px solid color-mix(in srgb, var(--color-musgo) 25%, transparent); }
</style>
