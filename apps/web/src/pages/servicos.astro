---
import Base from '../layouts/Base.astro';
import EstadoVazio from '../componentes/EstadoVazio.astro';
import TituloPagina from '../componentes/TituloPagina.astro';
import { servicos } from '../lib/conteudo';

const { dados, indisponivel } = await servicos();

// Agrupa por categoria preservando a ordem que veio do CMS (sort por
// categoria, nome). Serviço sem categoria cai num grupo próprio no fim.
const grupos = new Map<string, typeof dados>();
for (const servico of dados) {
  const chave = servico.categoria ?? 'Outros serviços';
  const atual = grupos.get(chave);
  if (atual) atual.push(servico);
  else grupos.set(chave, [servico]);
}
---

<Base
  titulo="Serviços"
  descricao="Serviços oferecidos pela Prefeitura Municipal de Cambuí ao cidadão."
>
  <TituloPagina titulo="Serviços ao cidadão" descricao="O que a prefeitura oferece e como solicitar." />

  <div class="mx-auto max-w-6xl px-4 py-10">
    {
      dados.length === 0 ? (
        <EstadoVazio indisponivel={indisponivel} assunto="serviços" />
      ) : (
        [...grupos.entries()].map(([categoria, lista]) => (
          <section class="mb-10">
            <h2 class="text-2xl font-bold text-azul-escuro">{categoria}</h2>
            <ul class="mt-4 grid gap-4 sm:grid-cols-2">
              {lista.map((servico) => (
                <li id={servico.slug} class="scroll-mt-24 rounded-lg border border-prata p-5">
                  <h3 class="text-lg font-bold text-azul-escuro">{servico.nome}</h3>
                  {servico.publico_alvo && (
                    <p class="mt-1 text-sm text-grafite">Para: {servico.publico_alvo}</p>
                  )}
                  {servico.descricao && <p class="mt-2 text-grafite">{servico.descricao}</p>}
                  {servico.como_solicitar && (
                    <div class="conteudo-rico mt-3 text-sm" set:html={servico.como_solicitar} />
                  )}

                  {servico.url_externa && (
                    <p class="mt-3">
                      <a
                        href={servico.url_externa}
                        rel="noopener noreferrer"
                        target="_blank"
                        class="font-semibold text-azul underline"
                      >
                        Acessar o serviço
                        {/* O aviso é lido pelo leitor de tela; o ícone sozinho
                            não informaria que a aba muda. */}
                        <span class="sr-only"> (abre em nova aba, site externo)</span>
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    </p>
                  )}

                  {servico.secretaria && (
                    <p class="mt-3 text-sm text-grafite">
                      Responsável:{' '}
                      <a href={`/secretarias/${servico.secretaria.slug}`} class="underline">
                        {servico.secretaria.nome}
                      </a>
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </div>
</Base>
