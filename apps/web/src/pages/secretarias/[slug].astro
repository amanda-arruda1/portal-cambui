---
/**
 * Página de secretaria.
 *
 * Ordem deliberada: primeiro COMO FALAR com ela (endereço, telefone, horário),
 * depois o que ela faz, e só então quem a dirige. O organograma interessa a
 * quem estuda a Prefeitura; o telefone interessa a quem precisa dela hoje.
 */
import Base from '../../layouts/Base.astro';
import Carreira from '../../componentes/Carreira.astro';
import TituloPagina from '../../componentes/TituloPagina.astro';
import { noticiasRecentes, secretariaPorSlug } from '../../lib/conteudo';
import { data, iso, linkMapa, linkTelefone, linkWhatsapp, numerosTelefone, recorte, semHtml } from '../../lib/formato';
import { limpar } from '../../lib/sanitizar';

const { slug } = Astro.params;
const { dado: sec } = await secretariaPorSlug(slug ?? '');
if (!sec) return Astro.rewrite('/404');

const { dados: noticias } = await noticiasRecentes(20);
const daSecretaria = noticias.filter((n) => n.secretaria?.slug === sec.slug).slice(0, 4);

interface ValorContato { texto: string; href: string | null; externo: boolean }
interface LinhaContato { rotulo: string; valores: ValorContato[] }

// Telefone pode ter mais de um número (ex.: "(35) 1111-1111 / (35) 2222-2222")
// — cada um vira seu próprio valor na mesma linha, com o link certo (WhatsApp
// quando é celular de verdade, tel: quando não é). O resto do cadastro
// (endereço, e-mail, horário) é sempre um valor só.
const linhasTelefone: ValorContato[] = sec.telefone
  ? numerosTelefone(sec.telefone).map((n) => {
      const whatsapp = linkWhatsapp(n.numero, n.nota);
      const mostrarNota = n.nota && !/^whatsapp$/i.test(n.nota);
      return { texto: `${n.numero}${mostrarNota ? ` (${n.nota})` : ''}`, href: whatsapp ?? linkTelefone(n.numero), externo: !!whatsapp };
    })
  : [];

const contatos: LinhaContato[] = [
  sec.endereco && { rotulo: 'Endereço', valores: [{ texto: sec.endereco, href: linkMapa(sec.endereco), externo: true }] },
  linhasTelefone.length > 0 && { rotulo: 'Telefone', valores: linhasTelefone },
  sec.email && { rotulo: 'E-mail', valores: [{ texto: sec.email, href: `mailto:${sec.email}`, externo: false }] },
  sec.horario_atendimento && { rotulo: 'Atendimento', valores: [{ texto: sec.horario_atendimento, href: null, externo: false }] },
].filter(Boolean) as LinhaContato[];
---

<Base
  titulo={sec.nome}
  descricao={recorte(semHtml(sec.descricao), 160) || `${sec.nome} da Prefeitura Municipal de Cambuí.`}
>
  <TituloPagina
    rotulo={sec.sigla ?? 'Secretaria'}
    titulo={sec.nome}
    trilha={[{ rotulo: 'A Prefeitura', destino: '/secretarias' }, { rotulo: sec.nome }]}
  />

  <Carreira numero="01" rotulo="Como falar com esta secretaria" fundo="papel">
    {
      contatos.length > 0 ? (
        <dl class="contatos entra">
          {contatos.map((c) => (
            <div class="par">
              <dt class="t-rotulo">{c.rotulo}</dt>
              <dd>
                {c.valores.map((v, i) => (
                  <>
                    {i > 0 && <br />}
                    {v.href ? (
                      <a href={v.href} {...(v.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                        <span class="fio-foco">{v.texto}</span>
                      </a>
                    ) : v.texto}
                  </>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      ) : (
        <p class="vazio">
          Os dados de atendimento desta secretaria estão em publicação. Enquanto isso, o telefone
          geral da Prefeitura atende e encaminha —{' '}
          <a href="/contato"><span class="fio-foco">ver contato</span></a>.
        </p>
      )
    }

    {(sec.responsavel || sec.cargo_responsavel) && (
      <p class="responsavel">
        <span class="t-rotulo">Responsável</span><br />
        {sec.responsavel}
        {sec.cargo_responsavel && <span class="cargo"> — {sec.cargo_responsavel}</span>}
      </p>
    )}
  </Carreira>

  {
    sec.descricao && (
      <Carreira numero="02" rotulo="O que esta secretaria faz">
        <div class="conteudo-rico texto entra" set:html={limpar(sec.descricao)} />
      </Carreira>
    )
  }

  {
    daSecretaria.length > 0 && (
      <Carreira numero="03" rotulo="Notícias desta secretaria" fundo="papel" acao={{ rotulo: 'Todas as notícias', destino: '/noticias' }}>
        <ul class="lista entra">
          {daSecretaria.map((n) => (
            <li>
              <a href={`/noticias/${n.slug}`} class="linha-tarefa">
                <span class="texto-rel">
                  <span class="t-rotulo meta"><time datetime={iso(n.data_publicacao)}>{data(n.data_publicacao)}</time></span>
                  <span class="t-sub titulo-rel"><span class="fio-foco">{n.titulo}</span></span>
                </span>
                <svg class="seta" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                  <path d="M4 11h13M12 6l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </Carreira>
    )
  }
</Base>

<style>
  .contatos { margin-top: 1.5rem; display: grid; gap: 1.25rem; max-width: 46rem; }
  @media (min-width: 40rem) { .contatos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 2.5rem; } }
  .par dt { color: var(--color-musgo); }
  .par dd { margin: 0.3rem 0 0; font-size: 1.0625rem; line-height: 1.5; }
  .par a { color: var(--color-serra); text-decoration: none; font-weight: 600; }

  .responsavel { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid color-mix(in srgb, var(--color-musgo) 26%, transparent); max-width: 46rem; }
  .responsavel .t-rotulo { color: var(--color-musgo); }
  .cargo { color: var(--color-musgo); }
  .vazio { margin-top: 1.25rem; color: var(--color-musgo); max-width: var(--container-leitura); }
  .vazio a { color: var(--color-serra); font-weight: 600; text-decoration: none; }
  .texto { margin-top: 1.25rem; }

  .lista { list-style: none; margin: 1.25rem 0 0; padding: 0; }
  .texto-rel { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .titulo-rel { font-family: var(--font-display); letter-spacing: -0.01em; }
  .meta { color: var(--color-musgo); }
  .seta { color: var(--color-carmim); flex: none; }
</style>
