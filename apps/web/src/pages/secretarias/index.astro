---
/**
 * A Prefeitura — secretarias.
 *
 * Chega-se aqui querendo falar com alguém. Por isso a lista mostra sigla,
 * nome e, quando houver, o telefone direto — antes de qualquer descrição.
 */
import Base from '../../layouts/Base.astro';
import TituloPagina from '../../componentes/TituloPagina.astro';
import Carreira from '../../componentes/Carreira.astro';
import LinhaTarefa from '../../componentes/LinhaTarefa.astro';
import { secretarias } from '../../lib/conteudo';
import { AUTARQUIAS } from '../../dados/instituicional';

const { dados, indisponivel } = await secretarias();
---

<Base
  titulo="A Prefeitura"
  descricao="Secretarias, autarquias e como falar com cada área da Prefeitura Municipal de Cambuí."
>
  <TituloPagina
    rotulo="A Prefeitura"
    titulo="Com quem você precisa falar"
    chamada="As secretarias do município, com endereço, telefone e horário de atendimento. Se não souber a qual delas recorrer, comece pelos serviços."
    trilha={[{ rotulo: 'A Prefeitura' }]}
  />

  <Carreira numero="01" rotulo="Secretarias municipais" fundo="papel">
    {
      indisponivel || dados.length === 0 ? (
        <p class="vazio">
          A relação das secretarias está sendo publicada. Enquanto isso, o telefone geral da
          Prefeitura atende e encaminha — <a href="/contato"><span class="fio-foco">ver contato</span></a>.
        </p>
      ) : (
        <ul class="lista entra">
          {dados.map((s) => (
            <li>
              <LinhaTarefa
                tarefa={{
                  rotulo: s.nome,
                  detalhe: [s.sigla, s.telefone, s.horario_atendimento].filter(Boolean).join(' · ') || 'Ver endereço e contato',
                  destino: `/secretarias/${s.slug}`,
                }}
              />
            </li>
          ))}
        </ul>
      )
    }
  </Carreira>

  <Carreira numero="02" rotulo="Autarquias" titulo="Serviços com portal próprio">
    <ul class="lista entra">
      {AUTARQUIAS.map((a) => (
        <li>
          <LinhaTarefa tarefa={{ rotulo: `${a.sigla} — ${a.nome}`, detalhe: a.descricao, destino: a.url, externo: true }} />
        </li>
      ))}
    </ul>
  </Carreira>

  <Carreira numero="03" rotulo="Organograma e estrutura" fundo="papel">
    <ul class="lista entra">
      <li>
        <LinhaTarefa
          tarefa={{ rotulo: 'Estrutura administrativa', detalhe: 'Organograma institucional e competências de cada órgão', destino: '/estrutura-administrativa' }}
        />
      </li>
      <li>
        <LinhaTarefa
          tarefa={{ rotulo: 'Conselhos municipais', detalhe: 'Leis, portarias e atas de cada conselho', destino: '/conselhos-municipais' }}
        />
      </li>
    </ul>
  </Carreira>
</Base>

<style>
  .lista { list-style: none; margin: 1.25rem 0 0; padding: 0; }
  .vazio { margin-top: 1.25rem; color: var(--color-musgo); max-width: var(--container-leitura); }
  .vazio a { color: var(--color-serra); font-weight: 600; text-decoration: none; }
</style>
