---
/**
 * Documentos oficiais.
 *
 * Inventário completo — editais, leis, decretos, portarias, Diário Oficial —
 * filtrável por tipo. Linhas de largura total, como o resto do portal: título
 * de documento oficial não pode ser truncado num cartão.
 */
import Base from '../layouts/Base.astro';
import Carreira from '../componentes/Carreira.astro';
import EstadoVazio from '../componentes/EstadoVazio.astro';
import Paginacao from '../componentes/Paginacao.astro';
import TituloPagina from '../componentes/TituloPagina.astro';
import { arquivo } from '../lib/directus';
import { documentos } from '../lib/conteudo';
import { data } from '../lib/formato';
import type { TipoDocumento } from '../lib/tipos';

const POR_PAGINA = 25;

const TIPOS: Array<{ chave: TipoDocumento | ''; rotulo: string }> = [
  { chave: '', rotulo: 'Todos' },
  { chave: 'edital', rotulo: 'Editais' },
  { chave: 'licitacao', rotulo: 'Licitações' },
  { chave: 'diario_oficial', rotulo: 'Diário Oficial' },
  { chave: 'lei', rotulo: 'Leis' },
  { chave: 'decreto', rotulo: 'Decretos' },
  { chave: 'portaria', rotulo: 'Portarias' },
];

// Só aceitamos tipo que existe na lista: qualquer outra coisa vinda da URL é
// descartada em vez de virar filtro no CMS.
const tipoBruto = Astro.url.searchParams.get('tipo') ?? '';
const tipo = TIPOS.some((t) => t.chave === tipoBruto) ? tipoBruto : '';

const bruto = Number.parseInt(Astro.url.searchParams.get('pagina') ?? '1', 10);
const pagina = Number.isFinite(bruto) && bruto > 0 ? bruto : 1;

const { dados, indisponivel } = await documentos(tipo || undefined, POR_PAGINA, pagina);
const totalPaginas = dados.length === POR_PAGINA ? pagina + 1 : pagina;
const base = tipo ? `/documentos?tipo=${tipo}` : '/documentos';
---

<Base
  titulo="Documentos oficiais"
  descricao="Editais, licitações, leis, decretos, portarias e edições do Diário Oficial do Município de Cambuí."
>
  <TituloPagina
    rotulo="Documentos"
    titulo="Documentos oficiais"
    chamada="Editais, licitações, leis, decretos, portarias e Diário Oficial — tudo num só lugar."
    trilha={[{ rotulo: 'Documentos oficiais' }]}
  />

  <Carreira numero="01" rotulo="Filtrar por tipo" fundo="papel">
    <nav aria-label="Filtrar por tipo" class="sem-impressao">
      <ul class="filtros">
        {
          TIPOS.map((item) => (
            <li>
              <a
                href={item.chave ? `/documentos?tipo=${item.chave}` : '/documentos'}
                aria-current={tipo === item.chave ? 'page' : undefined}
                class:list={['atalho', tipo === item.chave && 'ativo']}
              >
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      dados.length === 0 ? (
        <div class="mt-4">
          <EstadoVazio indisponivel={indisponivel} assunto="documentos" />
        </div>
      ) : (
        <ul class="lista entra">
          {dados.map((documento) => {
            const destino = documento.url_externa ?? arquivo(documento.arquivo);
            return (
              <li>
                {destino ? (
                  <a href={destino} class="linha-tarefa" target={documento.url_externa ? '_blank' : undefined} rel={documento.url_externa ? 'noopener noreferrer' : undefined}>
                    <span class="texto">
                      <span class="t-rotulo meta">
                        {data(documento.data_documento)}
                        {documento.numero && <> · nº {documento.numero}</>}
                      </span>
                      <span class="t-sub titulo"><span class="fio-foco">{documento.titulo}</span></span>
                      {documento.descricao && <span class="resumo t-micro">{documento.descricao}</span>}
                    </span>
                    <svg class="seta" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                      <path d="M4 11h13M12 6l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                ) : (
                  <div class="linha-tarefa sem-link">
                    <span class="texto">
                      <span class="t-rotulo meta">
                        {data(documento.data_documento)}
                        {documento.numero && <> · nº {documento.numero}</>}
                      </span>
                      <span class="t-sub titulo">{documento.titulo}</span>
                      {documento.descricao && <span class="resumo t-micro">{documento.descricao}</span>}
                    </span>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      )
    }

    <Paginacao pagina={pagina} totalPaginas={totalPaginas} base={base} />
  </Carreira>
</Base>

<style>
  .filtros { list-style: none; margin: 1.25rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .atalho {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 2px solid color-mix(in srgb, var(--color-serra) 30%, transparent);
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-serra);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .atalho:hover, .atalho.ativo { background: var(--color-serra); color: var(--color-papel); border-color: var(--color-serra); }

  .lista { list-style: none; margin: 2rem 0 0; padding: 0; }
  .texto { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .meta { color: var(--color-musgo); }
  .titulo { font-family: var(--font-display); letter-spacing: -0.01em; }
  .resumo { color: var(--color-musgo); }
  .seta { color: var(--color-carmim); flex: none; }
  .sem-link .texto { padding-block: 0.25rem; }
</style>
