---
/**
 * Página de uma matéria — a unidade que o cidadão realmente procura.
 *
 * O texto vem em HTML acessível e selecionável, não como PDF embutido. Isso
 * serve leitor de tela, tradução automática, indexação e citação. O PDF fica
 * ao lado, como o documento com fé pública — os dois papéis são diferentes e
 * a página diz qual é qual.
 */
import Base from '../../../../layouts/Base.astro';
import TituloPagina from '../../../../componentes/TituloPagina.astro';
import Citacao from '../../../../componentes/diario/Citacao.astro';
import DuasDatas from '../../../../componentes/diario/DuasDatas.astro';
import NotaLegal from '../../../../componentes/diario/NotaLegal.astro';
import { acervo, remissoesDe, situacaoDoAto, citacaoDe, materiasDaEdicao } from '../../../../lib/diario/indice';
import { rotuloTipoAto } from '../../../../lib/diario/vocabulario';
import { dataBr } from '../../../../lib/diario/dominio.mjs';
import type { RegraPrazo } from '../../../../lib/diario/dominio.mjs';
import { limpar } from '../../../../lib/sanitizar';
import { arquivo } from '../../../../lib/directus';

export const prerender = false;

const { ano, slug } = Astro.params;
const a = await acervo();
const m = a.porSlug.get(String(slug));

if (!m || String(m.edicaoObj?.ano ?? m.ano_ato) !== String(ano)) {
  return new Response(null, { status: 404, statusText: 'Matéria não encontrada' });
}

const edicao = m.edicaoObj!;
const remissoes = remissoesDe(a, m);
const situacao = situacaoDoAto(remissoes);
const citacao = citacaoDe(a, m);
const pdf = arquivo(edicao.arquivo_pdf);
const irmas = materiasDaEdicao(a, edicao);
const posicao = irmas.findIndex((x) => x.id === m.id);
const anterior = posicao > 0 ? irmas[posicao - 1] : null;
const proxima = posicao >= 0 && posicao < irmas.length - 1 ? irmas[posicao + 1] : null;
const urlDe = (x: typeof m) => `/diario-oficial/materia/${x.edicaoObj?.ano ?? x.ano_ato}/${x.slug}`;

/* O caderno de atos de pessoal fica fora do índice de buscadores: publicidade
 * legal é base para publicar, não para transformar o nome de um servidor em
 * primeiro resultado de busca pelo nome dele por toda a vida. O acesso público
 * continua inteiro — só não se convida o buscador a indexar. */
const semIndexacao = m.cadernoObj?.indexavel === false;

const paginas = m.pagina_inicial
  ? (m.pagina_final && m.pagina_final !== m.pagina_inicial ? `${m.pagina_inicial} a ${m.pagina_final}` : String(m.pagina_inicial))
  : null;
---
<Base titulo={`${m.titulo} — ${m.ementa.slice(0, 80)}`} descricao={m.ementa.slice(0, 180)} semIndexacao={semIndexacao}>
  <TituloPagina
    titulo={m.titulo}
    chamada={m.ementa}
    rotulo={m.cadernoObj?.nome}
    trilha={[
      { rotulo: 'Diário Oficial', destino: '/diario-oficial' },
      { rotulo: `Edição nº ${edicao.numero}`, destino: `/diario-oficial/edicao/${edicao.numero}` },
      { rotulo: m.titulo },
    ]}
  />

  <div class="carreira">
    <div class="ourela">
      <span class="fio fio-ourela" aria-hidden="true"></span>
      <div class="corpo conteudo">

        {edicao.anulada && (
          <div class="alerta anulada" role="note">
            <strong>Esta matéria foi publicada em edição anulada.</strong>
            <p>
              A Edição nº {edicao.numero} circulou e foi posteriormente anulada
              {edicao.anulada_em ? <> em <time datetime={edicao.anulada_em.slice(0, 10)}>{dataBr(edicao.anulada_em)}</time></> : null}.
              {edicao.anulada_justificativa}
            </p>
            <p>A edição permanece acessível porque o ato de anulação também é público.</p>
          </div>
        )}

        {situacao.tom !== 'vigente' && (
          <div class:list={['alerta', situacao.tom]} role="note">
            <strong>{situacao.rotulo}.</strong>
            <ul>
              {remissoes.retificadaPor.map((x) => (
                <li>Retificado pela <a href={urlDe(x)}>{x.titulo}</a>, publicada na Edição nº {x.edicaoObj?.numero}.</li>
              ))}
              {remissoes.republicadaPor.map((x) => (
                <li>Republicado por incorreção pela <a href={urlDe(x)}>{x.titulo}</a>, publicada na Edição nº {x.edicaoObj?.numero}.</li>
              ))}
              {remissoes.revogadaPor.map((x) => (
                <li>Revogado pela <a href={urlDe(x)}>{x.titulo}</a>, publicada na Edição nº {x.edicaoObj?.numero}.</li>
              ))}
            </ul>
            <p class="obs">O texto abaixo é o que foi efetivamente publicado. Ele não é alterado —
              a correção se faz pelo ato que o retifica, ao qual esta página remete.</p>
          </div>
        )}

        {(remissoes.retifica || remissoes.republica || remissoes.revoga) && (
          <div class="alerta alterado" role="note">
            <strong>Este ato altera outro.</strong>
            <ul>
              {remissoes.retifica && <li>Retifica a <a href={urlDe(remissoes.retifica)}>{remissoes.retifica.titulo}</a>,
                publicada na Edição nº {remissoes.retifica.edicaoObj?.numero}.</li>}
              {remissoes.republica && <li>Republica, por incorreção, a <a href={urlDe(remissoes.republica)}>{remissoes.republica.titulo}</a>,
                publicada na Edição nº {remissoes.republica.edicaoObj?.numero}.</li>}
              {remissoes.revoga && <li>Revoga a <a href={urlDe(remissoes.revoga)}>{remissoes.revoga.titulo}</a>,
                publicada na Edição nº {remissoes.revoga.edicaoObj?.numero}.</li>}
            </ul>
          </div>
        )}

        <dl class="ficha">
          <div><dt>Órgão de origem</dt><dd>{m.orgao}</dd></div>
          <div><dt>Tipo de ato</dt><dd>{rotuloTipoAto(m.tipo_ato)}</dd></div>
          {m.numero_ato && <div><dt>Número</dt><dd>{m.numero_ato}{m.ano_ato ? `/${m.ano_ato}` : ''}</dd></div>}
          <div><dt>Edição</dt><dd><a href={`/diario-oficial/edicao/${edicao.numero}`}>nº {edicao.numero}</a></dd></div>
          {paginas && <div><dt>Páginas</dt><dd>{paginas}</dd></div>}
          {m.processo_administrativo && <div><dt>Processo</dt><dd>{m.processo_administrativo}</dd></div>}
          <div><dt>Situação do ato</dt><dd>{situacao.rotulo}</dd></div>
        </dl>

        <DuasDatas
          disponibilizacao={edicao.data_disponibilizacao}
          publicacaoLegal={edicao.data_publicacao_legal}
          regra={(a.veiculo?.regra_prazo ?? 'primeiro_dia_util_seguinte') as RegraPrazo}
        />

        <article class="texto-ato" aria-label="Texto integral do ato">
          <h2 class="oculto-visual">Texto integral</h2>
          <div set:html={limpar(m.corpo ?? '')} />
        </article>

        <Citacao texto={citacao} />

        <section class="documentos">
          <h2>Documentos</h2>
          <ul>
            {pdf && (
              <li>
                <a href={pdf} class="principal">Edição nº {edicao.numero} completa, em PDF assinado</a>
                <span class="explica">É este o documento com fé pública. {edicao.total_paginas ? `${edicao.total_paginas} páginas.` : ''}</span>
              </li>
            )}
            <li>
              <a href={`/diario-oficial/materia/${ano}/${m.slug}/certidao`}>Certidão de publicação deste ato</a>
              <span class="explica">PDF assinado que comprova a publicação. É o que se anexa a processo administrativo —
                captura de tela não prova publicação.</span>
            </li>
            <li>
              <a href="/diario-oficial/autenticidade">Conferir a autenticidade dos arquivos</a>
              <span class="explica">Aceita o código verificador ou o próprio arquivo PDF.</span>
            </li>
          </ul>
        </section>

        {m.licitacao && (
          <p class="vinculo">
            Este ato integra um processo de contratação.
            <a href="/licitacoes">Ver no módulo de licitações</a>.
          </p>
        )}

        <nav class="vizinhas" aria-label="Outras matérias desta edição">
          {anterior ? <a href={urlDe(anterior)} rel="prev"><span>Matéria anterior</span>{anterior.titulo}</a> : <span />}
          {proxima ? <a href={urlDe(proxima)} rel="next" class="direita"><span>Próxima matéria</span>{proxima.titulo}</a> : <span />}
        </nav>

        <NotaLegal notaDoVeiculo={a.veiculo?.nota_legal} />
      </div>
    </div>
  </div>
</Base>

<style>
  .conteudo { padding-block: 1.5rem 3rem; }
  .oculto-visual { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

  .alerta { padding: 1rem 1.2rem; margin-bottom: 1.5rem; border-radius: 0 4px 4px 0;
    border-left: 4px solid var(--color-musgo);
    background: color-mix(in srgb, var(--color-musgo) 8%, transparent);
    max-width: var(--container-leitura); }
  .alerta.anulada, .alerta.revogado { border-left-color: var(--color-carmim);
    background: color-mix(in srgb, var(--color-carmim) 8%, transparent); }
  .alerta.alterado { border-left-color: var(--color-serra);
    background: color-mix(in srgb, var(--color-serra) 8%, transparent); }
  .alerta strong { display: block; margin-bottom: 0.35rem; color: var(--color-serra-noite); }
  .alerta.anulada strong, .alerta.revogado strong { color: var(--color-carmim); }
  .alerta ul { margin: 0.3rem 0 0; padding-left: 1.2rem; }
  .alerta li { margin-bottom: 0.25rem; }
  .alerta a { color: var(--color-serra); font-weight: 600; }
  .alerta .obs { margin: 0.6rem 0 0; font-size: 0.875rem; color: var(--color-musgo); }
  .alerta p { margin: 0.3rem 0 0; }

  .ficha { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: 0.9rem 1.5rem; margin: 0 0 1.75rem; padding-bottom: 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-musgo) 22%, transparent); }
  .ficha > div { min-width: 0; }
  .ficha dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--color-musgo); font-weight: 600; }
  .ficha dd { margin: 0.2rem 0 0; font-size: 1rem; color: var(--color-tinta); }
  .ficha a { color: var(--color-serra); font-weight: 600; }

  .texto-ato { max-width: var(--container-leitura); margin: 2rem 0; font-size: 1.0625rem; line-height: 1.75; }
  .texto-ato :global(p) { margin: 0 0 1rem; }
  .texto-ato :global(h4) { font-size: 1.0625rem; margin: 1.5rem 0 0.5rem; color: var(--color-serra-noite); }
  .texto-ato :global(strong) { font-weight: 700; }
  .texto-ato :global(ul), .texto-ato :global(ol) { margin: 0 0 1rem; padding-left: 1.5rem; }
  /* Tabela de matéria orçamentária não cabe em 360px: rola dentro da própria
     caixa, e a página nunca rola na horizontal. */
  .texto-ato :global(table) { display: block; overflow-x: auto; max-width: 100%;
    border-collapse: collapse; margin: 1.25rem 0; font-size: 0.9375rem; }
  .texto-ato :global(th), .texto-ato :global(td) {
    border: 1px solid color-mix(in srgb, var(--color-musgo) 30%, transparent);
    padding: 0.45rem 0.7rem; text-align: left; }
  .texto-ato :global(th) { background: color-mix(in srgb, var(--color-serra) 8%, transparent);
    font-weight: 600; color: var(--color-serra-noite); }
  .texto-ato :global(.assinatura) { margin-top: 1.5rem; font-weight: 600; }

  .documentos { margin: 2.5rem 0 0; }
  .documentos h2 { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--color-musgo); margin: 0 0 0.6rem; }
  .documentos ul { list-style: none; margin: 0; padding: 0; }
  .documentos li { padding: 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-musgo) 18%, transparent); }
  .documentos a { color: var(--color-serra); font-weight: 600; }
  .documentos .principal { font-size: 1.0625rem; }
  .documentos .explica { display: block; font-size: 0.875rem; color: var(--color-musgo); margin-top: 0.15rem; }

  .vinculo { margin: 1.5rem 0 0; font-size: 0.9375rem; color: var(--color-musgo); }
  .vinculo a { color: var(--color-serra); font-weight: 600; margin-left: 0.3rem; }

  .vizinhas { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2.5rem;
    padding-top: 1.25rem; border-top: 1px solid color-mix(in srgb, var(--color-musgo) 22%, transparent); }
  .vizinhas a { color: var(--color-tinta); text-decoration: none; max-width: 22rem; }
  .vizinhas a:hover { color: var(--color-serra); }
  .vizinhas span { display: block; font-size: 0.75rem; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--color-musgo); font-weight: 600; margin-bottom: 0.15rem; }
  .vizinhas .direita { text-align: right; }
</style>
