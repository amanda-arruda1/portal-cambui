---
/**
 * Página principal do Órgão Oficial.
 *
 * A listagem é de MATÉRIAS, não de edições. Foi a decisão de produto mais
 * consequente do módulo: os diários municipais que existem por aí listam
 * edições, e por isso obrigam o cidadão a saber a data do ato antes de
 * encontrá-lo. Quem procura "a portaria que me exonerou" não sabe a data — é
 * justamente o que ele quer descobrir.
 */
import Base from '../../layouts/Base.astro';
import TituloPagina from '../../componentes/TituloPagina.astro';
import Filtros from '../../componentes/diario/Filtros.astro';
import LinhaMateria from '../../componentes/diario/LinhaMateria.astro';
import NotaLegal from '../../componentes/diario/NotaLegal.astro';
import Paginacao from '../../componentes/Paginacao.astro';
import { acervo, lerFiltros, aplicarFiltros, contar, paraQuery, atalhoParaAto, temFiltro } from '../../lib/diario/indice';
import { dataBr } from '../../lib/diario/dominio.mjs';

const a = await acervo();
const f = lerFiltros(Astro.url);

/* "Decreto 1.245/2026" leva DIRETO à matéria. Listar quarenta resultados quando
 * a pessoa digitou o ato exato é fazê-la trabalhar de novo pelo que já disse. */
if (f.q) {
  const direto = atalhoParaAto(a, f.q);
  if (direto) {
    return Astro.redirect(`/diario-oficial/materia/${direto.edicaoObj?.ano ?? direto.ano_ato}/${direto.slug}`, 302);
  }
}

const ultimaEdicao = a.edicoes[0]?.numero ?? null;
const resultados = aplicarFiltros(a.materias, f, { ultimaEdicao });
const contagens = contar(a.materias, f, { ultimaEdicao });

const POR_PAGINA = 25;
const pagina = Math.max(1, Number(f.pagina) || 1);
const totalPaginas = Math.max(1, Math.ceil(resultados.length / POR_PAGINA));
const visiveis = resultados.slice((pagina - 1) * POR_PAGINA, pagina * POR_PAGINA);

const secretarias = [...new Map(
  a.materias.filter((m) => m.secretaria).map((m) => [m.secretaria!.slug, m.secretaria!]),
).values()].sort((x, y) => x.nome.localeCompare(y.nome, 'pt-BR'));

const base = `/diario-oficial${paraQuery({ ...f, pagina: '' })}`;
const ultima = a.edicoes[0] ?? null;
---
<Base
  titulo="Diário Oficial Eletrônico"
  descricao="Órgão oficial de publicidade dos atos do Município de Cambuí/MG. Busque leis, decretos, portarias, atos de pessoal, licitações e contratos pelo texto integral."
>
  <TituloPagina
    titulo="Diário Oficial Eletrônico"
    chamada="Órgão oficial de publicidade dos atos do Município de Cambuí. Busque no texto integral de todas as matérias publicadas."
    trilha={[{ rotulo: 'Diário Oficial' }]}
  />

  <div class="carreira">
    <div class="ourela">
      <span class="fio fio-ourela" aria-hidden="true"></span>
      <div class="corpo conteudo">

        {ultima && (
          <div class="destaque-ultima">
            <div>
              <span class="rotulo">Última edição publicada</span>
              <p class="numero">
                <a href={`/diario-oficial/edicao/${ultima.numero}`} class="fio-foco">
                  Edição nº {ultima.numero}
                </a>
              </p>
              <p class="data">
                Publicação legal em <time datetime={ultima.data_publicacao_legal}>{dataBr(ultima.data_publicacao_legal)}</time>
                {ultima.total_paginas ? ` · ${ultima.total_paginas} páginas` : ''}
              </p>
            </div>
            <div class="atalhos-topo">
              <a href="/diario-oficial/orgao-oficial">O que é o órgão oficial</a>
              <a href="/diario-oficial/autenticidade">Conferir autenticidade</a>
              <a href="/diario-oficial/arquivo">Arquivo por data</a>
              <a href="/diario-oficial/avisos">Receber por e-mail</a>
            </div>
          </div>
        )}

        <Filtros filtros={f} cadernos={a.cadernos} secretarias={secretarias} contagens={contagens} total={resultados.length} />

        {visiveis.length > 0 ? (
          <section class="lista" aria-labelledby="titulo-resultados">
            {/* O título existe para o leitor de tela e para a hierarquia: sem
                ele, a página salta de h1 para os h3 das matérias, e quem navega
                por títulos perde a noção de onde começa a lista. */}
            <h2 id="titulo-resultados" class="oculto-visual">
              Matérias encontradas — página {pagina} de {totalPaginas}
            </h2>
            {visiveis.map((r) => <LinhaMateria materia={r.materia} trecho={f.q ? r.trecho : undefined} />)}
          </section>
        ) : (
          <div class="vazio">
            <p class="titulo-vazio">Nenhuma matéria encontrada.</p>
            {a.indisponivel ? (
              <p>O sistema de publicações não respondeu agora. Tente novamente em alguns instantes.</p>
            ) : (
              <>
                <p>Algumas coisas que costumam resolver:</p>
                <ul>
                  {temFiltro(f) && <li>Amplie o período ou <a href="/diario-oficial">limpe os filtros</a>.</li>}
                  <li>Se procura um ato específico, digite o número: <em>“Portaria 88/2026”</em>.</li>
                  <li>O acervo começa em {a.edicoes.length ? dataBr(a.edicoes.at(-1)!.data_publicacao_legal) : '—'}.
                    Atos anteriores estão no veículo oficial da época — veja
                    <a href="/diario-oficial/orgao-oficial">a página do órgão oficial</a>.</li>
                  <li><a href="/diario-oficial/avisos">Cadastre um aviso por e-mail</a> e receba quando o assunto for publicado.</li>
                </ul>
              </>
            )}
          </div>
        )}

        <Paginacao pagina={pagina} totalPaginas={totalPaginas} base={base} />

        <div class="saidas">
          <h2>Levar estes resultados</h2>
          <p>Dados abertos, na forma do art. 8º, §3º, da Lei de Acesso à Informação.</p>
          <ul>
            <li><a href={`/diario-oficial/exportar.csv${paraQuery({ ...f, pagina: '' })}`}>Planilha CSV</a></li>
            <li><a href={`/api/diario-oficial${paraQuery({ ...f, pagina: '' })}`}>API em JSON</a></li>
            <li><a href="/diario-oficial/feed.xml">Assinatura RSS das novas edições</a></li>
          </ul>
        </div>

        <NotaLegal notaDoVeiculo={a.veiculo?.nota_legal} />
      </div>
    </div>
  </div>
</Base>

<style>
  .conteudo { padding-block: 1.5rem 3rem; }
  .destaque-ultima { display: flex; flex-wrap: wrap; gap: 1.25rem; justify-content: space-between;
    align-items: flex-start; padding: 1.1rem 1.3rem; margin-bottom: 1.75rem;
    background: color-mix(in srgb, var(--color-serra) 7%, transparent);
    border-left: 4px solid var(--color-serra); border-radius: 0 4px 4px 0; }
  .rotulo { font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--color-musgo); font-weight: 600; }
  .numero { margin: 0.15rem 0 0.2rem; font-size: 1.4rem; font-weight: 700; }
  .numero a { color: var(--color-serra-noite); text-decoration: none; }
  .data { margin: 0; font-size: 0.9375rem; color: var(--color-musgo); }
  .atalhos-topo { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; align-items: center; }
  .atalhos-topo a { font-size: 0.9375rem; color: var(--color-serra); font-weight: 600; }

  .oculto-visual { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .lista { margin-top: 0.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-musgo) 22%, transparent); }
  .vazio { padding: 2rem 1.5rem; text-align: left; max-width: var(--container-leitura);
    border: 1px solid color-mix(in srgb, var(--color-musgo) 25%, transparent); border-radius: 4px; }
  .titulo-vazio { font-size: 1.125rem; font-weight: 700; color: var(--color-serra-noite); margin: 0 0 0.6rem; }
  .vazio ul { margin: 0.5rem 0 0; padding-left: 1.2rem; }
  .vazio li { margin-bottom: 0.4rem; }
  .vazio a { color: var(--color-serra); font-weight: 600; }

  .saidas { margin-top: 2.5rem; padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-musgo) 22%, transparent); }
  .saidas h2 { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--color-musgo); margin: 0 0 0.3rem; }
  .saidas p { margin: 0 0 0.5rem; font-size: 0.9375rem; color: var(--color-musgo); }
  .saidas ul { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; list-style: none; margin: 0; padding: 0; }
  .saidas a { color: var(--color-serra); font-weight: 600; }
</style>
