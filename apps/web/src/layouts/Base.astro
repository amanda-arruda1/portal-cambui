---
/**
 * Esqueleto de toda página pública do portal.
 *
 * Ordem do DOM = ordem do teclado e do leitor de tela: barra de acessibilidade
 * (com os atalhos), cabeçalho, conteúdo, rodapé. Nada é reordenado por CSS.
 */
import '../estilos/global.css';
import BarraAcessibilidade from '../componentes/BarraAcessibilidade.astro';
import Cabecalho from '../componentes/Cabecalho.astro';
import Rodape from '../componentes/Rodape.astro';
import AvisoCookies from '../componentes/AvisoCookies.astro';
import { SITE } from '../dados/instituicional';
import { emDemonstracao } from '../lib/demonstracao';

interface Props {
  titulo: string;
  descricao?: string;
  semIndexacao?: boolean;
  imagem?: string | null;
  /** Páginas com hero próprio dispensam o respiro padrão do topo do <main>. */
  colado?: boolean;
}

const { titulo, descricao = SITE.descricao, semIndexacao = false, imagem = null, colado = false } = Astro.props;

const tituloCompleto = titulo === SITE.titulo ? titulo : `${titulo} — ${SITE.titulo}`;
const canonica = new URL(Astro.url.pathname, SITE.urlPublica).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    {semIndexacao && <meta name="robots" content="noindex, follow" />}

    <!-- As duas fontes são auto-hospedadas e entram no caminho crítico: sem o
         preload, o texto pisca na troca e o CLS sobe. -->
    <link rel="preload" href="/fontes/inter.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fontes/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.titulo} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="pt_BR" />
    {imagem && <meta property="og:image" content={new URL(imagem, SITE.urlPublica).href} />}

    <meta name="theme-color" content="#0C5430" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body class="pagina">
    {
      emDemonstracao() && (
        <div role="alert" class="faixa-demo sem-impressao">
          Versão de demonstração — o conteúdo desta página é ilustrativo e
          <strong> não tem valor oficial</strong>. O portal do município continua sendo
          <a href="https://www.prefeituradecambui.mg.gov.br"> prefeituradecambui.mg.gov.br</a>.
        </div>
      )
    }

    <BarraAcessibilidade />
    <Cabecalho />

    <main id="conteudo" class:list={['principal', !colado && 'respiro']}>
      <slot />
    </main>

    <Rodape />
    <AvisoCookies />

    <script>
      /* Entrada das faixas ao rolar. Uma vez por elemento, e só se a pessoa
         não pediu para reduzir movimento — a checagem é feita aqui e não só no
         CSS porque, sem ela, o observador ainda rodaria à toa. */
      const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const alvos = document.querySelectorAll('.entra');

      if (reduzir || !('IntersectionObserver' in window)) {
        alvos.forEach((el) => el.classList.add('visivel'));
      } else {
        const observador = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((e, i) => {
              if (!e.isIntersecting) return;
              // Escalonamento de 60ms: dá ritmo de carreira à rolagem.
              (e.target as HTMLElement).style.transitionDelay = `${Math.min(i, 4) * 60}ms`;
              e.target.classList.add('visivel');
              observador.unobserve(e.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );
        alvos.forEach((el) => observador.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .pagina { display: flex; min-height: 100vh; flex-direction: column; }
  .principal { flex: 1; }
  .respiro { padding-top: clamp(2rem, 5vw, 3.5rem); }

  .faixa-demo {
    background: var(--color-carmim);
    color: var(--color-papel);
    padding: 0.5rem 1rem;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .faixa-demo a { color: inherit; }
</style>
