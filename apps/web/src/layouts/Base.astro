---
/**
 * Esqueleto de toda página do portal.
 *
 * Concentra o que é obrigação de portal público e fácil de esquecer numa
 * página nova: idioma pt-BR, título e descrição próprios, URL canônica,
 * link de pular para o conteúdo e a estrutura de marcos (header/main/footer)
 * que o leitor de tela usa para navegar.
 */
import '../estilos/global.css';
import Cabecalho from '../componentes/Cabecalho.astro';
import Rodape from '../componentes/Rodape.astro';
import { SITE } from '../dados/instituicional';
import { emDemonstracao } from '../lib/demonstracao';

interface Props {
  titulo: string;
  descricao?: string;
  /** Some do índice de busca (páginas de erro, resultados de busca). */
  semIndexacao?: boolean;
  imagem?: string | null;
}

const { titulo, descricao = SITE.descricao, semIndexacao = false, imagem = null } = Astro.props;

const tituloCompleto = titulo === SITE.titulo ? titulo : `${titulo} — ${SITE.titulo}`;
const canonica = new URL(Astro.url.pathname, SITE.urlPublica).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    {semIndexacao && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.titulo} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="pt_BR" />
    {imagem && <meta property="og:image" content={new URL(imagem, SITE.urlPublica).href} />}

    <meta name="theme-color" content="#1A3868" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body class="flex min-h-screen flex-col">
    {
      /* Enquanto houver conteúdo de demonstração no banco, todo visitante
         precisa saber — inclusive quem chegar por engano ao endereço de
         homologação, que é público. */
      emDemonstracao() && (
        <div role="alert" class="bg-vermelho px-4 py-2 text-center text-sm font-semibold text-papel">
          Versão de demonstração — o conteúdo desta página é ilustrativo e
          <strong> não tem valor oficial</strong>. O portal do município continua sendo
          <a href="https://www.prefeituradecambui.mg.gov.br" class="underline"> prefeituradecambui.mg.gov.br</a>.
        </div>
      )
    }

    <!-- Primeiro elemento focável da página: quem navega por teclado não
         precisa percorrer o menu inteiro a cada página. -->
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-azul focus:px-4 focus:py-2 focus:text-papel"
    >
      Pular para o conteúdo principal
    </a>

    <Cabecalho />

    <main id="conteudo" class="flex-1">
      <slot />
    </main>

    <Rodape />
  </body>
</html>
