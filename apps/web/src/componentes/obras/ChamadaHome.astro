---
/**
 * OBRAS PÚBLICAS NA HOME — logo abaixo de Licitações.
 *
 * Mais simples que licitacoes/ChamadaHome.astro de propósito: sem avanço
 * automático (WCAG 2.2.2 é custo evitável quando rolagem nativa já resolve).
 * Prioriza o que mais interessa ao cidadão de imediato — obra PARALISADA
 * primeiro, depois em execução — e completa com as demais mais recentes.
 */
import Etiqueta from './Etiqueta.astro';
import { moeda, rotuloCategoria, valorAtual, todas } from '../../lib/obras';

const { dados, indisponivel } = await todas();

const PESO: Record<string, number> = { paralisada: 0, em_execucao: 1, nao_iniciada: 2, em_licitacao: 3, planejada: 4, concluida: 5, cancelada: 6 };
const destaques = [...dados]
  .sort((a, b) => (PESO[a.situacao] ?? 9) - (PESO[b.situacao] ?? 9) || +new Date(b.data_publicacao) - +new Date(a.data_publicacao))
  .slice(0, 6);
---

<section class="obras" aria-labelledby="titulo-obras">
  <div class="carreira">
    <div class="ourela">
      <span class="fio fio-ourela" aria-hidden="true"></span>
      <div class="corpo">
        <div class="cabeca">
          <h2 id="titulo-obras" class="t-rotulo rotulo">Obras públicas</h2>
          <a href="/obras" class="acao"><span class="fio-foco">Todas as obras</span> <span aria-hidden="true">→</span></a>
        </div>
        <p class="t-secao titulo">
          {indisponivel || dados.length === 0
            ? 'Acompanhamento de obras públicas'
            : `${dados.length} ${dados.length === 1 ? 'obra cadastrada' : 'obras cadastradas'} — contratos, prazos e execução financeira`}
        </p>

        {
          indisponivel || destaques.length === 0 ? (
            <p class="vazio">As obras públicas voltam a aparecer assim que o sistema de conteúdo for publicado.</p>
          ) : (
            <ul class="trilha">
              {destaques.map((o) => (
                <li class="cartao">
                  <a href={`/obras/${o.slug}`}>
                    <span class="topo">
                      <span class="t-rotulo categoria">{rotuloCategoria(o.categoria)}</span>
                      <Etiqueta situacao={o.situacao} />
                    </span>
                    <span class="objeto"><span class="fio-foco">{o.objeto_resumo}</span></span>
                    <span class="pe">
                      {o.percentual_execucao !== null && !['planejada', 'em_licitacao'].includes(o.situacao) && (
                        <span class="execucao">{o.percentual_execucao}% executado</span>
                      )}
                      <span class="valor">{valorAtual(o) ? moeda(valorAtual(o)) : 'Valor não divulgado'}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .obras { background: var(--color-neblina); padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .cabeca { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1.5rem; }
  .rotulo { color: var(--color-musgo); }
  .acao { color: inherit; text-decoration: none; font-weight: 600; font-size: 0.9375rem; }
  .titulo { margin-top: 0.35rem; max-width: 40ch; }
  .vazio { margin-top: 1.25rem; max-width: var(--container-leitura); color: var(--color-musgo); }

  .trilha {
    list-style: none; margin: 1.5rem 0 0; padding: 0 0 0.75rem;
    display: grid; grid-auto-flow: column; grid-auto-columns: min(19rem, 82vw);
    gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain; scrollbar-width: thin;
  }
  .cartao { scroll-snap-align: start; }
  .cartao > a {
    display: flex; flex-direction: column; gap: 0.6rem; height: 100%;
    padding: 1rem 1.1rem; border-radius: 6px;
    border: 1.5px solid color-mix(in srgb, var(--color-musgo) 30%, transparent);
    text-decoration: none; color: inherit; background: var(--color-papel);
  }
  .cartao > a:hover { border-color: var(--color-serra); }
  .topo { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .categoria { color: var(--color-musgo); }
  .objeto {
    font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .pe { margin-top: auto; display: grid; gap: 0.15rem; font-size: 0.875rem; color: var(--color-musgo); }
  .execucao { font-weight: 600; color: var(--color-serra); }
  .valor { font-variant-numeric: tabular-nums; }
</style>
