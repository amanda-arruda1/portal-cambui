---
/**
 * Uma obra na listagem. Mesma linha de largura total do sistema (ver
 * DESIGN.md). A ordem responde à pergunta do cidadão: o que é → onde → em
 * que situação → quanto custa → quanto já foi executado.
 */
import Etiqueta from './Etiqueta.astro';
import { moeda, rotuloCategoria, valorAtual, type Obra } from '../../lib/obras';

interface Props { obra: Obra }
const { obra: o } = Astro.props;
---

<a href={`/obras/${o.slug}`} class="linha">
  <span class="cabeca">
    <span class="t-rotulo identificacao">
      {rotuloCategoria(o.categoria)}
      <span class="processo"> · processo {o.numero_processo}</span>
    </span>
    <Etiqueta situacao={o.situacao} />
  </span>

  <span class="objeto"><span class="fio-foco">{o.objeto_resumo}</span></span>

  <span class="rodape">
    {o.secretaria && <span class="orgao">{o.secretaria.nome}</span>}
    <span class="valor">{valorAtual(o) ? moeda(valorAtual(o)) : 'Valor não divulgado'}</span>
    {o.percentual_execucao !== null && o.percentual_execucao !== undefined && o.situacao !== 'planejada' && o.situacao !== 'em_licitacao' && (
      <span class="execucao">{o.percentual_execucao}% executado</span>
    )}
  </span>
</a>

<style>
  .linha {
    display: flex; flex-direction: column; gap: 0.5rem;
    padding-block: 1.15rem;
    border-top: 1px solid color-mix(in srgb, var(--color-musgo) 26%, transparent);
    text-decoration: none; color: inherit;
  }
  :global(li:last-child) > .linha { border-bottom: 1px solid color-mix(in srgb, var(--color-musgo) 26%, transparent); }

  .cabeca { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; justify-content: space-between; }
  .identificacao { color: var(--color-musgo); }
  .processo { font-weight: 400; text-transform: none; letter-spacing: 0; }
  @media (max-width: 30rem) { .processo { display: none; } }

  .objeto {
    font-family: var(--font-display); font-size: 1.15rem; font-weight: 600;
    line-height: 1.3; letter-spacing: -0.01em;
  }

  .rodape { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; font-size: 0.9375rem; color: var(--color-musgo); }
  .valor { font-variant-numeric: tabular-nums; }
  .execucao { font-weight: 600; color: var(--color-serra); }
</style>
