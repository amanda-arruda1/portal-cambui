---
interface Props {
  titulo: string;
  descricao?: string;
}
const { titulo, descricao } = Astro.props;
---
<div class="border-b border-prata bg-papel-suave">
  <div class="mx-auto max-w-6xl px-4 py-8">
    <h1 class="text-3xl font-bold text-azul-escuro sm:text-4xl">{titulo}</h1>
    {descricao && <p class="mt-2 max-w-2xl text-grafite">{descricao}</p>}
  </div>
</div>
