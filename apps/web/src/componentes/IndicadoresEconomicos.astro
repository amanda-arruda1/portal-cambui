---
/**
 * Indicadores econômicos — IPCA, Selic, CDI e Dólar, direto na home.
 *
 * Mesma composição dos outros widgets independentes desta página
 * (ChamadaLicitacoes, ChamadaObras, InstagramFeed): busca os próprios
 * dados, se envolve na carreira numerada, e nunca derruba a home se a fonte
 * externa estiver fora — cada cartão degrada para "indisponível" sozinho
 * (ver lib/indicadores.ts).
 *
 * Cartão simples de propósito — são só 4 itens, sem carrossel nem rolagem: a
 * faixa de licitações rola porque pode ter dezenas; aqui cabe tudo junto em
 * qualquer tela.
 */
import { indicadoresEconomicos } from '../lib/indicadores';

const indicadores = await indicadoresEconomicos();

const formatoPercentual = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const formatoMoeda = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

function valorFormatado(i: (typeof indicadores)[number]): string {
  if (i.valor === null) return '—';
  return i.unidade === 'moeda' ? formatoMoeda.format(i.valor) : `${formatoPercentual.format(i.valor)}%`;
}

/** IPCA/Selic/CDI comparam ponto contra ponto (pontos percentuais); o dólar
 *  já vem da fonte como variação percentual do próprio dia. */
function variacaoFormatada(i: (typeof indicadores)[number]): string | null {
  if (i.variacao === null) return null;
  const sinal = i.variacao > 0 ? '+' : '';
  const unidade = i.chave === 'dolar' ? '%' : ' p.p.';
  return `${sinal}${formatoPercentual.format(i.variacao)}${unidade}`;
}
---

<section class="indicadores" aria-labelledby="titulo-indicadores">
  <div class="carreira">
    <div class="ourela">
      <div class="marca">
        <span class="fio fio-ourela" aria-hidden="true"></span>
      </div>
      <div class="corpo">
        <div class="cabeca">
          <h2 id="titulo-indicadores" class="t-rotulo rotulo">Economia</h2>
          <a
            href="https://www.bcb.gov.br/estatisticas/indicadoreseconomicos"
            target="_blank"
            rel="noopener noreferrer"
            class="acao"
          >
            <span class="fio-foco">Mais indicadores no Banco Central</span> <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="t-secao titulo">Indicadores econômicos</p>

        <ul class="grade entra">
          {
            indicadores.map((i) => {
              const variacao = variacaoFormatada(i);
              const subindo = i.variacao !== null && i.variacao > 0;
              const descendo = i.variacao !== null && i.variacao < 0;
              return (
                <li class="cartao">
                  <p class="t-rotulo nome">{i.rotulo}</p>
                  {i.valor === null ? (
                    <p class="indisponivel">Indisponível no momento</p>
                  ) : (
                    <>
                      <p class="valor">{valorFormatado(i)}</p>
                      {variacao && (
                        <p class:list={['variacao', subindo && 'subindo', descendo && 'descendo']}>
                          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            {subindo ? (
                              <path d="M4 13 10 7l6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                            ) : descendo ? (
                              <path d="M4 7l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                            ) : (
                              <path d="M4 10h12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                            )}
                          </svg>
                          {variacao}
                        </p>
                      )}
                    </>
                  )}
                  <p class="descricao">{i.descricao}</p>
                  {i.referencia && (
                    <p class="rodape-cartao">
                      {i.referencia} · {i.fonte}
                    </p>
                  )}
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .indicadores { background: var(--color-neblina); padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .marca { display: flex; flex-direction: column; align-items: flex-start; gap: 0.5rem; }
  .fio { flex: 1; min-height: 3rem; }

  .cabeca { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1.5rem; }
  .rotulo { color: var(--color-musgo); }
  .acao { color: inherit; text-decoration: none; font-weight: 600; font-size: 0.9375rem; }
  .titulo { margin-top: 0.35rem; max-width: 26ch; }

  .grade {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 30rem) { .grade { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; } }
  @media (min-width: 60rem) { .grade { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .cartao {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 1.1rem;
    border-radius: 8px;
    background: var(--color-papel);
    border: 1px solid color-mix(in srgb, var(--color-musgo) 22%, transparent);
  }
  .nome { color: var(--color-musgo); }
  .valor {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .indisponivel { color: var(--color-musgo); font-style: italic; font-size: 0.9375rem; margin-top: 0.15rem; }

  .variacao {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    width: fit-content;
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-musgo);
  }
  /* Cor INVERTIDA de propósito frente à convenção comum de mercado (alta =
     verde): os quatro indicadores aqui são inflação, juros e câmbio — para
     quem lê como cidadão, SUBIR é a notícia de atenção (fica mais caro
     tomar crédito, mais caro importar) e DESCER é a boa notícia. Por isso
     "subindo" usa âmbar (atenção), não verde. Cores fora da paleta
     institucional de propósito, mesmo raciocínio do assistente de contatos
     (turquesa): ninguém lê "alta"/"queda" numa cor que também significa
     "ação padrão do site". */
  .variacao.subindo { color: #b45309; }
  .variacao.descendo { color: var(--color-carmim); }
  [data-tema='escuro'] .variacao.subindo { color: #fbbf24; }

  .descricao { margin-top: 0.15rem; font-size: 0.875rem; color: var(--color-musgo); }
  .rodape-cartao { margin-top: auto; padding-top: 0.5rem; font-size: 0.75rem; color: var(--color-musgo); opacity: 0.85; }
</style>
