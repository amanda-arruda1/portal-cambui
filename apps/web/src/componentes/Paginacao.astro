---
interface Props {
  pagina: number;
  totalPaginas: number;
  base: string;
}
const { pagina, totalPaginas, base } = Astro.props;

// `base` pode já carregar filtro (ex.: /documentos?tipo=edital). Colar um '?'
// fixo geraria '?tipo=edital?pagina=2' e o filtro se perderia na volta.
const separador = base.includes('?') ? '&' : '?';
const anterior = pagina > 1 ? `${base}${separador}pagina=${pagina - 1}` : null;
const proxima = pagina < totalPaginas ? `${base}${separador}pagina=${pagina + 1}` : null;
---
{
  totalPaginas > 1 && (
    <nav aria-label="Paginação" class="paginacao">
      {anterior ? (
        <a href={anterior} rel="prev" class="botao">← Anteriores</a>
      ) : (
        <span />
      )}

      <p aria-live="polite" class="t-micro pagina-atual">
        Página {pagina} de {totalPaginas}
      </p>

      {proxima ? (
        <a href={proxima} rel="next" class="botao">Próximas →</a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .paginacao { margin-top: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .pagina-atual { color: var(--color-musgo); }
  .botao {
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0.6rem 1.2rem;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none;
    background: var(--color-papel);
    color: var(--color-serra);
    border: 2px solid var(--color-serra);
  }
  .botao:hover { background: var(--color-serra); color: var(--color-papel); }
</style>
