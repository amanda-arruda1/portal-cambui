---
/**
 * FEED DO INSTAGRAM NA HOME — os 5 posts mais recentes, logo abaixo de
 * Notícias.
 *
 * Estrutura manual (carreira/ourela/corpo), igual
 * `componentes/licitacoes/ChamadaHome.astro` — não dá pra usar o
 * `<Carreira>` genérico porque o cabeçalho precisa do ícone do Instagram ao
 * lado do título e de um botão "Seguir" de verdade, não do link de texto
 * que `Carreira.astro` (prop `acao`) oferece.
 *
 * Carrossel por rolagem nativa com encaixe (scroll-snap): é o que dá touch
 * e arrasto de graça no celular, sem gesto customizado — o script só
 * adiciona as setas para quem usa mouse/teclado. Mesmo padrão de
 * `ChamadaHome.astro`.
 *
 * `simulado` (ver `lib/instagram.ts`) é true enquanto não houver token da
 * conta oficial configurado: os 5 cards são gerados, não posts reais, e o
 * aviso abaixo do cabeçalho existe para isso nunca passar por publicação de
 * verdade sem ninguém perceber.
 */
import { postsInstagram, PERFIL_INSTAGRAM } from '../lib/instagram';
import { dataCurta, iso } from '../lib/formato';

const { dados: posts, simulado } = await postsInstagram();
---

<section class="instagram" aria-labelledby="titulo-instagram">
  <div class="carreira">
    <div class="ourela">
      <span class="fio fio-ourela" aria-hidden="true"></span>
      <div class="corpo">
        <div class="cabeca">
          <div class="titulo-grupo">
            <svg class="icone-ig" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8" />
              <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" />
            </svg>
            <h2 id="titulo-instagram" class="t-rotulo rotulo">Acompanhe no Instagram</h2>
          </div>
          <a href={PERFIL_INSTAGRAM.url} target="_blank" rel="noopener noreferrer" class="seguir">
            Seguir {PERFIL_INSTAGRAM.handle}
            <span class="sr-only"> — abre em uma nova aba</span>
          </a>
        </div>

        {
          simulado && (
            <p class="t-micro aviso-simulado">
              Prévia — conteúdo ilustrativo até a conta oficial ser conectada.
            </p>
          )
        }

        <div class="faixa" data-faixa-instagram>
          <button type="button" class="seta seta-anterior" data-seta="anterior" aria-label="Posts anteriores" aria-controls="trilha-instagram">
            <svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true">
              <path d="M13.5 4 7 11l6.5 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <ul id="trilha-instagram" class="trilha" data-trilha-instagram tabindex="0" role="list" aria-label="Posts recentes do Instagram">
            {posts.map((post) => (
              <li class="cartao">
                <a href={post.permalink} target="_blank" rel="noopener noreferrer">
                  <span class="miniatura">
                    <img src={post.imagem} alt="" width="400" height="400" loading="lazy" decoding="async" />
                  </span>
                  <span class="legenda">{post.legenda}</span>
                  <span class="pe">
                    <time datetime={iso(post.data)}>{dataCurta(post.data)}</time>
                    <span class="ver">
                      Ver no Instagram
                      <svg width="14" height="14" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                        <path d="M4 11h13M12 6l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>

          <button type="button" class="seta seta-proxima" data-seta="proxima" aria-label="Próximos posts" aria-controls="trilha-instagram">
            <svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true">
              <path d="M8.5 4 15 11l-6.5 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* neblina, não papel: Notícias (antes) e Licitações (depois) já são
     brancas — sem uma faixa neutra entre as duas, os três blocos se
     fundiriam num só. */
  .instagram { background: var(--color-neblina); padding-block: clamp(2.5rem, 6vw, 4.5rem); }

  .cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  .titulo-grupo { display: flex; align-items: center; gap: 0.55rem; min-width: 0; }
  .icone-ig { flex: none; color: var(--color-carmim); }
  .rotulo { color: var(--color-musgo); }

  .seguir {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--color-serra);
    border-radius: 999px;
    color: var(--color-serra);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
  }
  .seguir:hover { background: var(--color-serra); color: var(--color-papel); }

  .aviso-simulado { margin-top: 0.5rem; color: var(--color-musgo); }

  .faixa {
    margin-top: 1.25rem;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem;
  }

  /* Rolagem nativa com encaixe: dá touch/arrasto no celular sem gesto
     customizado. A altura mínima evita deslocamento de layout quando as
     imagens ainda estão carregando. */
  .trilha {
    list-style: none;
    margin: 0;
    padding: 0 0 0.75rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(16rem, 78vw);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }
  .trilha:focus-visible { outline: 3px solid var(--color-carmim); outline-offset: 4px; }

  .cartao { scroll-snap-align: start; }
  .cartao > a {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    border-radius: 10px;
    border: 1.5px solid color-mix(in srgb, var(--color-musgo) 25%, transparent);
    background: var(--color-papel);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    box-shadow: 0 0.3rem 0.9rem -0.5rem color-mix(in srgb, var(--color-tinta) 30%, transparent);
    transition: border-color 150ms ease-out, transform 150ms ease-out;
  }
  .cartao > a:hover { border-color: var(--color-serra); transform: translateY(-2px); }

  .miniatura { display: block; aspect-ratio: 1 / 1; background: var(--color-neblina); }
  .miniatura img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .legenda {
    padding: 0 0.9rem;
    font-size: 0.875rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pe {
    margin-top: auto;
    padding: 0 0.9rem 0.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-musgo);
  }
  .ver { display: inline-flex; align-items: center; gap: 0.25rem; color: var(--color-serra); font-weight: 600; }
  .cartao > a:hover .ver { text-decoration: underline; }

  .seta {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--color-musgo) 35%, transparent);
    background: var(--color-papel);
    color: var(--color-serra);
    cursor: pointer;
  }
  .seta:hover { border-color: var(--color-serra); }
  .seta:disabled { opacity: 0.35; cursor: default; }
  .seta:disabled:hover { border-color: color-mix(in srgb, var(--color-musgo) 35%, transparent); }

  /* Setas só fazem sentido onde há espaço sobrando ao lado da faixa — no
     celular a rolagem por dedo já resolve, e o alvo de 44px roubaria largura
     dos cartões numa tela de 360px. */
  @media (min-width: 40rem) {
    .seta { display: inline-flex; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-faixa-instagram]').forEach((faixa) => {
    const trilha = faixa.querySelector<HTMLElement>('[data-trilha-instagram]');
    const anterior = faixa.querySelector<HTMLButtonElement>('[data-seta="anterior"]');
    const proxima = faixa.querySelector<HTMLButtonElement>('[data-seta="proxima"]');
    if (!trilha || !anterior || !proxima) return;

    const passo = () => (trilha.querySelector('.cartao')?.clientWidth ?? 260) + 16;

    anterior.addEventListener('click', () => trilha.scrollBy({ left: -passo(), behavior: 'smooth' }));
    proxima.addEventListener('click', () => trilha.scrollBy({ left: passo(), behavior: 'smooth' }));

    const atualizarSetas = () => {
      const fim = trilha.scrollWidth - trilha.clientWidth - 2;
      anterior.disabled = trilha.scrollLeft <= 2;
      proxima.disabled = trilha.scrollLeft >= fim;
    };

    trilha.addEventListener('scroll', atualizarSetas, { passive: true });
    window.addEventListener('resize', atualizarSetas);
    atualizarSetas();
  });
</script>
