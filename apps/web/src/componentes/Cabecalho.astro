---
/**
 * Cabeçalho.
 *
 * O anti-padrão que este componente recusa: faixa superior azul-institucional
 * com brasão à esquerda e menu horizontal genérico. Aqui:
 *   - o fundo é a neblina, não uma faixa de cor chapada;
 *   - o maior elemento não é o brasão nem o menu: é A BUSCA. O cidadão chega
 *     com uma tarefa, e a busca é o caminho mais curto até ela;
 *   - a Transparência e o e-SIC ficam no topo, sempre visíveis — exigência da
 *     Lei de Acesso à Informação, não enfeite;
 *   - o menu, no celular, é <details>: abre e fecha sem uma linha de
 *     JavaScript, e continua funcionando se o script falhar.
 */
import { MUNICIPIO } from '../dados/instituicional';
import { NECESSIDADES } from '../dados/cidade';

const SECOES = [
  {
    rotulo: 'Serviços',
    destino: '/servicos',
    /* Categorias por necessidade — o mesmo índice de servicos.astro, só que
       alcançável a partir de qualquer página. Dado estático (dados/cidade.ts):
       nenhuma chamada nova ao CMS num componente que carrega em toda página. */
    subitens: NECESSIDADES.map((n) => ({ rotulo: n.titulo, destino: `/servicos#${n.chave}` })),
  },
  { rotulo: 'A cidade', destino: '/a-cidade' },
  { rotulo: 'A Prefeitura', destino: '/secretarias' },
  /* O Diário Oficial entra no menu principal, e não num canto: é onde os atos
     do município produzem efeito, e quem procura um ato precisa achá-lo em um
     passo. Entra antes de Transparência porque é destino mais específico. */
  { rotulo: 'Diário Oficial', destino: '/diario-oficial' },
  { rotulo: 'Transparência', destino: '/transparencia' },
  { rotulo: 'Notícias', destino: '/noticias' },
];

const atual = Astro.url.pathname;
const ehAtual = (destino: string) => atual === destino || (destino !== '/' && atual.startsWith(destino + '/'));
---

<header class="cabecalho">
  <div class="carreira topo">
    <div class="ourela">
      <span aria-hidden="true"></span>
      <div class="corpo linha-topo">
        <!-- Sem aria-label: ele SUBSTITUIRIA o texto visível, e um nome
             acessível que não contém o que está escrito na tela confunde quem
             navega por voz ("clicar em Prefeitura de Cambuí" não acharia o
             link). O complemento entra como texto para leitor de tela. -->
        <a href="/" class="marca">
          <!-- brasao.png é um LOCKUP horizontal (1126×510) com o texto em
               branco, feito para fundo escuro: usado como quadrado ficava
               esmagado, e o texto some sobre a neblina. Aqui entra só o
               símbolo, recortado do original e já quadrado. -->
          <img src="/brasao-simbolo.png" alt="" width="44" height="44" decoding="async" />
          <span class="nomes">
            <strong>Prefeitura de {MUNICIPIO.nome}</strong>
            <span class="t-rotulo uf">Minas Gerais</span>
          </span>
          <span class="sr-only">— ir para a página inicial</span>
        </a>

        <!-- LAI: acesso destacado e sempre visível. -->
        <nav aria-label="Acesso à informação" class="lai sem-impressao">
          <a href="/transparencia"><span class="fio-foco">Transparência</span></a>
          <a href="http://cambui.eouve.com.br/" target="_blank" rel="noopener noreferrer"><span class="fio-foco">Ouvidoria</span></a>
          <a href="http://cambui.eouve.com.br/" target="_blank" rel="noopener noreferrer"><span class="fio-foco">e-SIC</span></a>
        </nav>
      </div>
    </div>
  </div>

  <div class="carreira">
    <div class="ourela">
      <span class="fio fio-ourela" aria-hidden="true"></span>
      <div class="corpo">
        <form action="/busca" method="get" role="search" class="busca" id="busca">
          <label for="q" class="t-rotulo etiqueta">O que você precisa resolver?</label>
          <div class="campo">
            <input
              id="q"
              name="q"
              type="search"
              autocomplete="off"
              placeholder="IPTU, coleta de lixo, alvará, licitação…"
              enterkeyhint="search"
            />
            <button type="submit">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="2" />
                <path d="M13.5 13.5L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <span>Buscar</span>
            </button>
          </div>
        </form>

        <nav id="menu" aria-label="Menu principal" class="menu sem-impressao">
          <details class="sanfona">
            <summary>
              <span aria-hidden="true">☰</span> Seções do portal
            </summary>
            <ul>
              {SECOES.map((s) => (
                <li class:list={[s.subitens && 'com-subitens']}>
                  <a href={s.destino} aria-current={ehAtual(s.destino) ? 'page' : undefined}>
                    <span class="fio-foco">{s.rotulo}</span>
                  </a>
                  {s.subitens && (
                    <ul class="subitens">
                      {s.subitens.map((sub) => (
                        <li>
                          <a href={sub.destino}><span class="fio-foco">{sub.rotulo}</span></a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </details>
        </nav>
      </div>
    </div>
  </div>
</header>

<style>
  .cabecalho { background: var(--color-neblina); }
  /* Os respiros do cabeçalho pelo mínimo do clamp: a 360px o cabeçalho
     custava 278px, e junto com a barra de acessibilidade consumia 323px
     antes de qualquer conteúdo. Nenhum ELEMENTO encolheu — brasão, faixa da
     LAI, busca e menu estão todos aqui, do mesmo tamanho. Só os vãos. Do
     tablet para cima os termos em vw voltam a mandar e o desktop é idêntico. */
  .topo { padding-top: clamp(0.5rem, 2.5vw, 0.9rem); }
  .linha-topo { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: clamp(0.35rem, 2vw, 0.75rem) 1.5rem; }

  .marca { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: inherit; }
  .marca img { display: block; }
  .nomes { display: flex; flex-direction: column; line-height: 1.15; }
  .nomes strong { font-family: var(--font-display); font-size: 1.15rem; font-weight: 700; letter-spacing: -0.02em; }
  .uf { color: var(--color-musgo); }

  /* Os três links da LAI eram texto puro, sem padding: 23px de alvo de toque
     no celular — abaixo do piso de 24px do Lighthouse e muito abaixo dos 44px
     que este projeto exige na LinhaTarefa. Passou despercebido porque a
     auditoria de alvo de toque não pontua na categoria de acessibilidade.

     O alvo vem do min-height, a régua do projeto. A margem negativa fica no
     CONTÊINER (nunca nos itens: nos itens, dois links que quebrassem de linha
     passariam a se sobrepor) e devolve ao layout quase tudo o que o alvo
     tomou — o cabeçalho não regride os 40px do commit anterior.

     O `position: relative` NÃO é enfeite, e a caixa de 44px não funciona sem
     ele. A margem negativa faz o link transbordar para fora da sua carreira;
     o `.corpo` da carreira seguinte vem depois no DOM, pinta por cima e
     ROUBA O TOQUE dos 11px de baixo. Medido com elementsFromPoint: o alvo
     real era 34px, não 44 — o `min-height` sozinho é alvo de mentira aqui.
     O que o link passa a cobrir é vão: o rótulo da busca só começa 2px
     abaixo do pé da caixa. Se algo for inserido entre a LAI e a busca, esta
     conta muda e precisa ser remedida. */
  .lai { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; font-size: 0.875rem; font-weight: 600;
         margin-block: -0.55rem; position: relative; z-index: 1; }
  .lai a {
    color: var(--color-serra);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  /* A busca é o maior elemento do cabeçalho. É a tese aplicada: o cidadão
     chega com uma tarefa. */
  .busca { margin-top: clamp(0.75rem, 3.5vw, 1.25rem); }
  .etiqueta { display: block; color: var(--color-musgo); margin-bottom: clamp(0.25rem, 1.2vw, 0.4rem); }
  .campo { display: flex; gap: 0.5rem; }
  .campo input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 1.0625rem;
    padding: 0.85rem 1rem;
    min-height: 3.25rem;
    border: 2px solid var(--color-serra);
    border-radius: 4px;
    background: var(--color-papel);
    color: var(--color-tinta);
  }
  .campo input::placeholder { color: var(--color-musgo); opacity: 1; }
  .campo button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-weight: 600;
    padding: 0 1.35rem;
    min-height: 3.25rem;
    border: 2px solid var(--color-serra);
    border-radius: 4px;
    background: var(--color-serra);
    color: var(--color-papel);
    cursor: pointer;
  }
  .campo button:hover { background: var(--color-serra-noite); border-color: var(--color-serra-noite); }
  /* Abaixo de 480px o rótulo sai da vista, mas NÃO do documento: com
     display:none o botão ficava sem nome acessível e o leitor de tela
     anunciava só "botão". Pego pelo Lighthouse; a lupa sozinha não é nome. */
  @media (max-width: 30rem) {
    .campo button span {
      position: absolute;
      width: 1px; height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
    .campo button { padding-inline: 1rem; }
  }

  /* Menu: <details> no celular, lista horizontal no desktop. Sem JavaScript
     em nenhum dos dois. */
  .menu { margin-top: clamp(0.5rem, 2.5vw, 1rem); padding-bottom: clamp(0.5rem, 2.5vw, 1rem); }
  .sanfona summary {
    list-style: none;
    cursor: pointer;
    font-weight: 600;
    /* O padding cai, o min-height NAO: 2,75rem e o alvo de toque e continua
       sendo quem manda na altura final. */
    padding: 0.5rem 0;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-musgo) 28%, transparent);
  }
  .sanfona summary::-webkit-details-marker { display: none; }
  .sanfona ul { list-style: none; margin: 0; padding: 0 0 0.5rem; display: grid; gap: 0.15rem; }
  .sanfona a {
    display: block;
    padding: 0.7rem 0;
    min-height: 2.75rem;
    text-decoration: none;
    color: inherit;
    font-weight: 600;
  }
  .sanfona a[aria-current='page'] { color: var(--color-carmim); }

  /* Subitens de "Serviços" no celular: sanfona já os mostra abertos, só
     recuados e um degrau menores — nada de segundo <details> aninhado. */
  .subitens {
    list-style: none;
    margin: 0 0 0.4rem;
    padding-left: 1rem;
    display: grid;
    gap: 0.1rem;
    border-left: 2px solid color-mix(in srgb, var(--color-musgo) 28%, transparent);
  }
  .subitens a { font-weight: 400; padding-block: 0.55rem; min-height: 2.5rem; color: var(--color-musgo); }

  @media (min-width: 48rem) {
    .sanfona summary { display: none; }
    .sanfona ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 2rem;
      border-top: 1px solid color-mix(in srgb, var(--color-musgo) 28%, transparent);
      padding-top: 0.25rem;
    }
    .sanfona[open] ul, .sanfona ul { display: flex; }
    .menu { margin-top: 1.5rem; }

    /* Coluna suspensa: uma lista estreita, não um mega-painel de cartões. Abre
       por hover e por foco (:focus-within cobre chegar via Tab no link-pai;
       sem JavaScript, como o resto do menu). */
    .com-subitens { position: relative; }
    .com-subitens .subitens {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 2;
      margin: 0;
      padding: 0.5rem 0;
      min-width: 15rem;
      border: none;
      border-top: 3px solid var(--color-carmim);
      background: var(--color-papel);
      box-shadow: 0 0.75rem 1.5rem -0.5rem color-mix(in srgb, var(--color-tinta) 25%, transparent);
    }
    .com-subitens:hover .subitens,
    .com-subitens:focus-within .subitens { display: grid; }
    .com-subitens .subitens a {
      padding: 0.6rem 1.1rem;
      color: var(--color-tinta);
      font-weight: 600;
    }
    .com-subitens .subitens a:hover,
    .com-subitens .subitens a:focus-visible { color: var(--color-serra); background: var(--color-neblina); }
  }
</style>

<script>
  /* No desktop o <details> precisa nascer aberto, senão o menu horizontal
     some. Feito por script porque é ajuste de apresentação, não de conteúdo:
     sem JavaScript, o menu continua acessível pelo próprio <summary>. */
  const consulta = window.matchMedia('(min-width: 48rem)');
  const sanfona = document.querySelector<HTMLDetailsElement>('.sanfona');
  const sincronizar = () => { if (sanfona) sanfona.open = consulta.matches; };
  sincronizar();
  consulta.addEventListener('change', sincronizar);
</script>
