---
/**
 * Cabeçalho.
 *
 * O anti-padrão que este componente recusa: faixa superior azul-institucional
 * com brasão à esquerda e menu horizontal genérico. Aqui:
 *   - o fundo é a neblina, não uma faixa de cor chapada;
 *   - a busca continua sendo o elemento mais chamativo do cabeçalho — só que
 *     desde 2026-08-31, a pedido do usuário, abaixo do menu de seções, não
 *     acima: o cidadão vê para onde o site vai antes de decidir buscar;
 *   - Transparência, Ouvidoria e e-SIC SAÍRAM da faixa de topo em 2026-09-02,
 *     a pedido do usuário — a exigência da Lei de Acesso à Informação
 *     continua cumprida: Transparência está no menu principal (SECOES,
 *     abaixo) e os três seguem no rodapé (Rodape.astro, coluna "Acesso à
 *     informação"), só não duplicados aqui também;
 *   - o menu, no celular, é <details>: abre e fecha sem uma linha de
 *     JavaScript, e continua funcionando se o script falhar. O SUBMENU de
 *     "Serviços" é a exceção, em qualquer tela: abre só no clique da seta
 *     (nunca sozinho — nem no hover do desktop, nem preso aberto no
 *     celular), e por isso depende do script no fim do arquivo.
 */
import { MUNICIPIO } from '../dados/instituicional';
import { indicadoresEconomicos, valorFormatado } from '../lib/indicadores';
import { previsaoTempo, categoriaTempo, condicaoTexto, temperaturaFormatada } from '../lib/tempo';
import IconeTempo from './IconeTempo.astro';
// import { NECESSIDADES } from '../dados/cidade'; // volta junto com o submenu, ver abaixo

/* Único lugar do portal que mostra os 4 indicadores desde 2026-09-03 (o
   cartão "Economia" saiu da home, a pedido do usuário) — discreta, na faixa
   do brasão, em toda página. Sem cor de alta/baixa aqui de propósito: é só
   um resumo pra quem já sabe o que está olhando; quem quiser o detalhe
   completo (variação, fonte, referência) segue direto para o Banco Central. */
const [indicadores, tempo] = await Promise.all([indicadoresEconomicos(), previsaoTempo()]);
const rotuloCompacto = (chave: string, rotulo: string) => (chave === 'dolar' ? 'Dólar' : rotulo);

type Secao = {
  rotulo: string;
  destino?: string;
  subitens?: { rotulo: string; destino: string }[];
};

const SECOES: Secao[] = [
  {
    rotulo: 'Serviços',
    destino: '/servicos',
    /* Submenu DESLIGADO em 2026-08-31 a pedido do usuário — ficou com um
       comportamento errado que ele reportou por imagem e ainda não
       consegui ver (caminho local do Windows dele, sem acesso daqui).
       NECESSIDADES e a estrutura de subitens continuam prontas logo abaixo,
       só não são passadas pra este item — é reativar esta linha quando o
       problema estiver identificado e corrigido.
       subitens: NECESSIDADES.map((n) => ({ rotulo: n.titulo, destino: `/servicos#${n.chave}` })), */
  },
  { rotulo: 'A cidade', destino: '/a-cidade' },
  { rotulo: 'A Prefeitura', destino: '/secretarias' },
  { rotulo: 'Telefones Úteis', destino: '/telefones' },
  { rotulo: 'Patrimônio Cultural', destino: '/patrimonio-cultural' },
  /* O Diário Oficial entra no menu principal, e não num canto: é onde os atos
     do município produzem efeito, e quem procura um ato precisa achá-lo em um
     passo. Entra antes de Transparência porque é destino mais específico. */
  { rotulo: 'Diário Oficial', destino: '/diario-oficial' },
  { rotulo: 'Transparência', destino: '/transparencia' },
  { rotulo: 'Notícias', destino: '/noticias' },
  {
    rotulo: 'Área do Servidor',
    /* Sem destino próprio: é só um agrupador de sistemas externos (ponto,
       SIP e webmail), todos em outro domínio — abrem em nova aba. */
    subitens: [
      { rotulo: 'Ponto eletrônico', destino: 'http://sistemas14.sisponto.com.br/Sispontoweb/open.do?sys=SPW' },
      { rotulo: 'Holerite eletrônico', destino: 'https://cce.sgpcloud.net:9155/sipweb/trabalhador/login/login.xhtml' },
      /* URL de webmail enviada pelo usuário era de LOGOUT com um token de
         sessão embutido (?_task=logout&_token=...) — publicar isso no código
         (repositório público) vazaria o token de outra pessoa e, de todo
         modo, não é um link de acesso. Trocado pela URL base, a pedido do
         usuário em 2026-09-02. */
      { rotulo: 'Webmail', destino: 'https://webmail.cambui.mg.gov.br/' },
    ],
  },
];

const atual = Astro.url.pathname;
const ehAtual = (destino: string) => atual === destino || (destino !== '/' && atual.startsWith(destino + '/'));
---

<header class="cabecalho sobre-serra">
  <div class="carreira topo">
    <div class="ourela">
      <span aria-hidden="true"></span>
      <div class="corpo linha-topo">
        <!-- Sem aria-label: ele SUBSTITUIRIA o texto visível, e um nome
             acessível que não contém o que está escrito na tela confunde quem
             navega por voz ("clicar em Prefeitura de Cambuí" não acharia o
             link). O complemento entra como texto para leitor de tela. -->
        <a href="/" class="marca">
          <!-- brasao.png é um LOCKUP horizontal (1126×510) com o texto em
               branco, feito para fundo escuro: usado como quadrado ficava
               esmagado, e o texto some sobre a neblina. Aqui entra só o
               símbolo, recortado do original e já quadrado. Aumentado de
               44 para 56px em 2026-09-10, a pedido do usuário: precisava
               ficar mais visível e na altura das duas linhas do nome
               ("Prefeitura de Cambuí" + "Minas Gerais"), que juntas somam
               algo perto disso. Fonte original é 480×480, sobra resolução
               de sobra pro tamanho maior. -->
          <img src="/brasao-simbolo.png" alt="" width="56" height="56" decoding="async" />
          <span class="nomes">
            <strong>Prefeitura de {MUNICIPIO.nome}</strong>
            <span class="t-rotulo uf">Minas Gerais</span>
          </span>
          <span class="sr-only">— ir para a página inicial</span>
        </a>

        <div class="extras-topo">
          {tempo && (
            <div
              class="tempo-topo"
              title={`Cambuí/MG — ${condicaoTexto(tempo.codigo_tempo)}${tempo.sensacao_termica !== null ? `, sensação de ${temperaturaFormatada(tempo.sensacao_termica)}` : ''}`}
            >
              <IconeTempo categoria={categoriaTempo(tempo.codigo_tempo)} tamanho={22} />
              <span class="valor-tempo" aria-hidden="true">{temperaturaFormatada(tempo.temperatura)}</span>
              <span class="sr-only">
                Tempo agora em Cambuí: {condicaoTexto(tempo.codigo_tempo)}, {temperaturaFormatada(tempo.temperatura)}
                {tempo.sensacao_termica !== null && `, sensação de ${temperaturaFormatada(tempo.sensacao_termica)}`}
              </span>
            </div>
          )}

          <a
            href="https://www.bcb.gov.br/estatisticas/indicadoreseconomicos"
            target="_blank"
            rel="noopener noreferrer"
            class="indicadores-topo"
            aria-label="Indicadores econômicos — mais detalhes no Banco Central (abre em uma nova aba)"
          >
            <ul>
              {indicadores.map((i) => (
                <li>
                  <span class="rotulo-ind">{rotuloCompacto(i.chave, i.rotulo)}</span>
                  <span class="valor-ind">{valorFormatado(i)}</span>
                </li>
              ))}
            </ul>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="carreira">
    <div class="ourela">
      <span class="fio fio-ourela" aria-hidden="true"></span>
      <div class="corpo">
        <nav id="menu" aria-label="Menu principal" class="menu sem-impressao">
          <details class="sanfona">
            <summary>
              <span aria-hidden="true">☰</span> Seções do portal
            </summary>
            <ul>
              {/* Submenu de "Serviços" segue DESLIGADO — ver comentário em
                  SECOES, acima. "Área do Servidor" é o único item com
                  subitens hoje: agrupa sistemas externos (ponto, SIP,
                  webmail), por isso não tem `destino` próprio — só o rótulo
                  e a seta abrem/fecham a lista, via o script no fim do
                  arquivo. */}
              {SECOES.map((s) => (
                <li class:list={[s.subitens && 'com-subitens']}>
                  {s.subitens ? (
                    <div class="item-menu">
                      <button type="button" class="rotulo-menu">
                        <span class="fio-foco">{s.rotulo}</span>
                      </button>
                      <button type="button" class="alterna-submenu" aria-expanded="false" aria-label={`Abrir submenu de ${s.rotulo}`}>
                        <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                          <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </button>
                    </div>
                  ) : (
                    <a href={s.destino} aria-current={ehAtual(s.destino!) ? 'page' : undefined}>
                      <span class="fio-foco">{s.rotulo}</span>
                    </a>
                  )}
                  {s.subitens && (
                    <ul class="subitens">
                      {s.subitens.map((sub) => (
                        <li>
                          <a href={sub.destino} target="_blank" rel="noopener noreferrer">
                            <span class="fio-foco">{sub.rotulo}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </details>
        </nav>

        <form action="/busca" method="get" role="search" class="busca" id="busca">
          <label for="q" class="t-rotulo etiqueta">O que você precisa resolver?</label>

          <div class="campo-vidro" id="campo-vidro">
            <div class="campo">
              <div class="entrada">
                <!-- A lupa É o gatilho da busca agora — não enfeite ao lado
                     de um botão "Buscar" separado. type="submit" já cobre
                     clique nela E Enter no campo (é o único controle de
                     envio do formulário, o navegador trata os dois como o
                     mesmo disparo). -->
                <button type="submit" class="lupa-gatilho" aria-label="Buscar">
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="2" />
                    <path d="M13.5 13.5L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  </svg>
                </button>
                <input
                  id="q"
                  name="q"
                  type="search"
                  autocomplete="off"
                  placeholder="Digite para pesquisar…"
                  enterkeyhint="search"
                />
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</header>

<style>
  /* Redesenho de 2026-08-31: cabeçalho escuro, gradiente do preto para o
     azul institucional — a faixa que fica no ar em toda página, contínua
     com o degradê maior do hero da home (index.astro). `.sobre-serra`
     (global.css) já troca o anel de foco pra branco aqui de graça. */
  .cabecalho {
    background: linear-gradient(180deg, var(--color-preto), var(--color-serra-noite));
    /* --color-sobre-escuro, não --color-papel: este fundo não muda com o
       tema (ver a nota em global.css), então o texto também não pode. */
    color: var(--color-sobre-escuro);
  }
  /* Vence a regra global `.sobre-serra :focus-visible` (mesma especificidade,
     mas esta é a mais específica de verdade depois do escopo do Astro) —
     precisa, porque o fundo daqui não muda de tom no modo escuro. */
  .cabecalho :focus-visible { outline-color: var(--color-sobre-escuro); }
  /* Os respiros do cabeçalho pelo mínimo do clamp: a 360px o cabeçalho
     custava 278px, e junto com a barra de acessibilidade consumia 323px
     antes de qualquer conteúdo. Nenhum ELEMENTO encolheu — brasão, faixa da
     LAI, busca e menu estão todos aqui, do mesmo tamanho. Só os vãos. Do
     tablet para cima os termos em vw voltam a mandar e o desktop é idêntico. */
  .topo { padding-top: clamp(0.5rem, 2.5vw, 0.9rem); }
  .linha-topo { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: clamp(0.35rem, 2vw, 0.75rem) 1.5rem; }

  .marca { display: flex; align-items: center; gap: 0.85rem; text-decoration: none; color: inherit; }
  .marca img { display: block; flex: none; }
  .nomes { display: flex; flex-direction: column; line-height: 1.15; }
  /* Nome do município — aumentado a pedido do usuário em 2026-09-02 (era
     1.15rem/0.8125rem). Ganha mais peso visual porque um brasão novo está a
     caminho pra acompanhar; `clamp` pra não estourar em telas estreitas. */
  .nomes strong { font-family: var(--font-display); font-size: clamp(1.3rem, 2.6vw, 1.6rem); font-weight: 700; letter-spacing: -0.02em; }
  .uf { color: rgba(255, 255, 255, 0.6); font-size: 0.9375rem; }

  /* Faixa compacta do tempo + indicadores econômicos — mesma linha do
     brasão, empurrada pra direita pelo `justify-content: space-between` de
     `.linha-topo`. Deliberadamente discreta (fonte pequena, cor apagada,
     sem cartão/borda): o detalhe colorido de alta/baixa já mora no cartão
     "Economia" da home, pra onde o link de indicadores leva. Escondida no
     celular — não cabe do lado do brasão a essa largura, e é um extra, não
     essencial (mesmo raciocínio já medido para os indicadores). */
  .extras-topo { display: none; align-items: center; gap: 1.25rem; }
  @media (min-width: 60rem) { .extras-topo { display: flex; } }

  .tempo-topo { display: flex; align-items: center; gap: 0.35rem; color: rgba(255, 255, 255, 0.8); cursor: default; }
  .tempo-topo :global(svg) { flex: none; opacity: 0.85; }
  .valor-tempo { font-size: 0.9375rem; font-weight: 600; font-variant-numeric: tabular-nums; }

  .indicadores-topo { text-decoration: none; color: inherit; }
  .indicadores-topo ul { display: flex; align-items: baseline; gap: 1.1rem; margin: 0; padding: 0; list-style: none; }
  .indicadores-topo li { display: flex; align-items: baseline; gap: 0.3rem; white-space: nowrap; }
  .indicadores-topo .rotulo-ind {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.45);
  }
  .indicadores-topo .valor-ind {
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.8);
  }
  .indicadores-topo:hover .valor-ind,
  .indicadores-topo:focus-visible .valor-ind { color: var(--color-sobre-escuro); }

  /* A busca é o maior elemento do cabeçalho — agora abaixo do menu, não
     acima. É a tese aplicada mesmo assim: o cidadão vê as seções e, logo
     abaixo, o caminho mais curto até a tarefa. */
  .busca {
    margin-top: clamp(0.75rem, 3vw, 1.25rem);
    padding-bottom: clamp(0.5rem, 2.5vw, 1rem);
    /* Entrada da faixa ao carregar a página — só uma vez, só aqui (nunca no
       .campo-vidro: esse elemento já usa `transform` pra inclinação 3D, e uma
       animação de entrada na MESMA propriedade do MESMO elemento brigaria
       com o transform que o script escreve depois — o fill-mode da animação
       ganha da regra normal e trava a inclinação no valor final do keyframe).
       `prefers-reduced-motion` zera a duração sozinho (regra global). */
    animation: entrada-busca 550ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 60ms;
    text-align: center;
  }
  @media (min-width: 48rem) { .busca { margin-top: 1.5rem; } }
  @keyframes entrada-busca {
    from { opacity: 0; transform: translateY(10px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
  .etiqueta { display: block; color: rgba(255, 255, 255, 0.7); margin-bottom: clamp(0.25rem, 1.2vw, 0.4rem); }

  /* Vidro: fundo translúcido sobre o degradê do cabeçalho (é o próprio
     degradê, borrado, que dá o efeito — nada por trás foi desenhado só pra
     isso). O campo de texto em si continua opaco e branco: é onde o
     contraste tem de ser garantido, e "vidro" nele quebraria a leitura. */
  .campo-vidro {
    position: relative;
    padding: 0.4rem;
    max-width: 42rem;
    margin-inline: auto;
    border-radius: 16px;
    background: color-mix(in srgb, var(--color-papel) 9%, transparent);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border: 1px solid color-mix(in srgb, var(--color-papel) 20%, transparent);
    box-shadow: 0 1.5rem 3rem -1.4rem rgba(0, 0, 0, 0.6);
    transform: perspective(900px) rotateX(var(--inclinacao-x, 0deg)) rotateY(var(--inclinacao-y, 0deg));
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 220ms ease-out, border-color 220ms ease-out;
  }
  @media (max-width: 30rem) { .campo-vidro { max-width: none; } }
  .campo-vidro:focus-within {
    border-color: color-mix(in srgb, var(--color-carmim-brilho) 55%, transparent);
    box-shadow: 0 1.5rem 3rem -1.2rem rgba(0, 0, 0, 0.65);
  }
  /* Brilho que acompanha o cursor — só a posição muda por script;
     visibilidade e cor são CSS puro. */
  .campo-vidro::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(16rem circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      color-mix(in srgb, var(--color-carmim-brilho) 30%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 200ms ease-out;
    pointer-events: none;
  }
  .campo-vidro:hover::before, .campo-vidro:focus-within::before { opacity: 1; }

  .campo { display: flex; gap: 0.5rem; position: relative; }
  .entrada { position: relative; flex: 1; min-width: 0; display: flex; align-items: center; }
  .campo input {
    width: 100%;
    font: inherit;
    font-size: 1.0625rem;
    padding: 0.85rem 1rem 0.85rem 3.35rem;
    min-height: 3.25rem;
    border: 2px solid var(--color-serra);
    border-radius: 12px;
    background: var(--color-papel);
    color: var(--color-tinta);
  }
  .campo input::placeholder { color: var(--color-musgo); opacity: 1; }

  /* A lupa é o gatilho da busca — ponto focal do campo, não enfeite. Estados,
     em ordem de prioridade crescente (a ordem no arquivo decide o empate):
     cor neutra parada → cor+brilho quando pronta pra buscar (foco OU texto
     digitado — :has(input:not(:placeholder-shown)) cobre o segundo caso sem
     precisar de JS) → escala/rotação/glow no hover → encolhe no clique. */
  .lupa-gatilho {
    position: absolute;
    left: 0.3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 2,75rem = 44px, o alvo de toque padrão do projeto (LinhaTarefa, LAI,
       sanfona...) — a lupa virou o único jeito de disparar a busca, não dá
       pra ficar menor do que o resto. */
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--color-musgo);
    cursor: pointer;
    transition: color 200ms ease-out, transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 200ms ease-out;
  }
  .entrada:focus-within .lupa-gatilho,
  .entrada:has(input:not(:placeholder-shown)) .lupa-gatilho {
    color: var(--color-carmim);
    box-shadow: 0 0 0 7px color-mix(in srgb, var(--color-carmim) 14%, transparent);
  }
  .lupa-gatilho:hover {
    transform: scale(1.1) rotate(-8deg);
    box-shadow: 0 0 0 9px color-mix(in srgb, var(--color-serra) 14%, transparent);
  }
  .entrada:focus-within .lupa-gatilho:hover,
  .entrada:has(input:not(:placeholder-shown)) .lupa-gatilho:hover {
    box-shadow: 0 0 0 9px color-mix(in srgb, var(--color-carmim) 20%, transparent);
  }
  .lupa-gatilho:active {
    transform: scale(0.9) rotate(-4deg);
    transition-duration: 90ms;
  }

  /* Menu: <details> no celular, lista horizontal no desktop. Sem JavaScript
     em nenhum dos dois — o clique que abre/fecha o SUBMENU é a única parte
     com script (mais abaixo); a sanfona em si continua funcionando sem JS. */
  .menu { margin-top: clamp(0.75rem, 3.5vw, 1.25rem); }
  .sanfona summary {
    list-style: none;
    cursor: pointer;
    font-weight: 600;
    /* O padding cai, o min-height NAO: 2,75rem e o alvo de toque e continua
       sendo quem manda na altura final. */
    padding: 0.5rem 0;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .sanfona summary::-webkit-details-marker { display: none; }
  /* `>` e não descendente: mesma armadilha da regra do desktop, logo abaixo
     — "ul" sozinho também bateria em `.subitens` (é uma <ul> aninhada
     dentro de `.sanfona`) com mais especificidade que `.subitens
     {display:none}`, MANTENDO o submenu sempre visível mesmo fechado
     também no celular. */
  .sanfona > ul { list-style: none; margin: 0; padding: 0 0 0.5rem; display: grid; gap: 0.15rem; }
  .sanfona a {
    display: block;
    padding: 0.7rem 0;
    min-height: 2.75rem;
    text-decoration: none;
    color: inherit;
    font-weight: 600;
  }
  .sanfona a[aria-current='page'] { color: var(--color-carmim-brilho); }

  /* Envolve o rótulo + o botão de seta de quem tem submenu, sem mudar o
     alcance de toque do link em si. */
  .item-menu { display: flex; align-items: center; }
  .item-menu a { flex: 1; }
  /* "Área do Servidor" não tem destino próprio (só agrupa links externos),
     então o rótulo também é um <button> — clicar nele ou na seta abre o
     submenu, mesmo efeito, mesmo listener (script no fim do arquivo). Reset
     de botão pra parecer texto, igual aos outros itens do menu. */
  .rotulo-menu {
    flex: 1;
    display: block;
    padding: 0.7rem 0;
    min-height: 2.75rem;
    background: none;
    border: none;
    color: inherit;
    font: inherit;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }
  .alterna-submenu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .alterna-submenu svg { transition: transform 180ms ease-out; }
  .alterna-submenu[aria-expanded='true'] svg { transform: rotate(180deg); }

  /* Subitens de "Serviços": ESCONDIDOS por padrão em qualquer tela — só
     `.com-subitens.aberto` (classe do script, no clique da seta) revela.
     Antes desta correção só o desktop tinha esse controle; no celular a
     lista de Casa/Saúde/Educação... aparecia sempre que a sanfona abria,
     virando um bloco estático sem alternância nenhuma. */
  .subitens {
    display: none;
    list-style: none;
    margin: 0 0 0.4rem;
    padding-left: 1rem;
    gap: 0.1rem;
    border-left: 2px solid rgba(255, 255, 255, 0.18);
  }
  .com-subitens.aberto .subitens { display: grid; }
  .subitens a { font-weight: 400; padding-block: 0.55rem; min-height: 2.5rem; color: rgba(255, 255, 255, 0.72); }

  @media (min-width: 48rem) {
    .sanfona summary { display: none; }
    /* `>` e não descendente: "ul" sozinho também bateria em `.subitens`
       (é uma <ul> dentro de `.sanfona`) e essa regra tem mais especificidade
       que `.subitens { display:none }` — o submenu ficava sempre visível no
       desktop, ignorando a classe `.aberto` que o script alterna. Bug real,
       achado testando clique de verdade (Chromium headless via CDP), não só
       lendo o CSS. */
    .sanfona > ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 2rem;
      border-top: 1px solid rgba(255, 255, 255, 0.18);
      padding-top: 0.25rem;
    }
    .menu { margin-top: 1.5rem; }

    /* Coluna suspensa: uma lista estreita, não um mega-painel de cartões.
       Aberta/fechada é sempre a mesma regra acima (.aberto); aqui só entra
       o que muda a APARÊNCIA no desktop — vira cartão flutuante em vez de
       lista recuada inline. */
    .com-subitens { position: relative; }
    .com-subitens .subitens {
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 2;
      margin: 0;
      padding: 0.5rem 0;
      min-width: 15rem;
      border: none;
      border-top: 3px solid var(--color-carmim);
      background: var(--color-papel);
      box-shadow: 0 0.75rem 1.5rem -0.5rem color-mix(in srgb, var(--color-tinta) 25%, transparent);
    }
    .com-subitens .subitens a {
      padding: 0.6rem 1.1rem;
      color: var(--color-tinta);
      font-weight: 600;
    }
    .com-subitens .subitens a:hover,
    .com-subitens .subitens a:focus-visible { color: var(--color-serra); background: var(--color-neblina); }
  }
</style>

<script>
  /* No desktop o <details> precisa nascer aberto, senão o menu horizontal
     some. Feito por script porque é ajuste de apresentação, não de conteúdo:
     sem JavaScript, o menu continua acessível pelo próprio <summary>. */
  const consulta = window.matchMedia('(min-width: 48rem)');
  const sanfona = document.querySelector<HTMLDetailsElement>('.sanfona');
  const sincronizar = () => { if (sanfona) sanfona.open = consulta.matches; };
  sincronizar();
  consulta.addEventListener('change', sincronizar);

  /* Submenu do menu principal: abre só no clique da seta, nunca sozinho no
     hover — era o hover que fazia parecer "estático"/grudado. O botão fica
     escondido no celular (a sanfona já mostra os subitens abertos), então
     este bloco só tem efeito visível no desktop. */
  const itensComSubmenu = document.querySelectorAll<HTMLLIElement>('.com-subitens');
  function fecharSubmenus(exceto?: HTMLLIElement) {
    itensComSubmenu.forEach((li) => {
      if (li === exceto) return;
      li.classList.remove('aberto');
      li.querySelector('.alterna-submenu')?.setAttribute('aria-expanded', 'false');
    });
  }
  itensComSubmenu.forEach((li) => {
    const botaoAlterna = li.querySelector<HTMLButtonElement>('.alterna-submenu');
    const botaoRotulo = li.querySelector<HTMLButtonElement>('.rotulo-menu');
    const alternar = () => {
      const abrindo = !li.classList.contains('aberto');
      fecharSubmenus();
      li.classList.toggle('aberto', abrindo);
      botaoAlterna?.setAttribute('aria-expanded', String(abrindo));
    };
    botaoAlterna?.addEventListener('click', alternar);
    botaoRotulo?.addEventListener('click', alternar);
  });
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Node)) return;
    const dentroDeAlgumSubmenu = Array.from(itensComSubmenu).some((li) => li.contains(e.target as Node));
    if (!dentroDeAlgumSubmenu) fecharSubmenus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') fecharSubmenus();
  });

  /* Ctrl+K / Cmd+K continua funcionando (foca a busca de qualquer página) —
     só o selo visual saiu, a pedido do usuário. Atalho sem dica na tela é
     comum o bastante (é o mesmo de várias ferramentas) pra não custar nada
     manter pra quem já sabe. */
  const campoBusca = document.getElementById('q') as HTMLInputElement | null;
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      campoBusca?.focus();
    }
  });

  /* Brilho e inclinação 3D seguindo o cursor. Só liga com mouse de verdade
     (`pointer: fine` — em toque o navegador nunca dispara mousemove aqui,
     mas a checagem evita o listener à toa) e sem pedido de menos movimento;
     a inclinação fica em ~3°, o bastante pra sentir profundidade sem virar
     brinquedo num portal de prefeitura. */
  const vidro = document.getElementById('campo-vidro');
  const reduzirMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const temMousePreciso = window.matchMedia('(pointer: fine)').matches;
  if (vidro && !reduzirMovimento && temMousePreciso) {
    vidro.addEventListener('mousemove', (e) => {
      const r = vidro.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;
      vidro.style.setProperty('--mouse-x', `${x * 100}%`);
      vidro.style.setProperty('--mouse-y', `${y * 100}%`);
      vidro.style.setProperty('--inclinacao-y', `${(x - 0.5) * 6}deg`);
      vidro.style.setProperty('--inclinacao-x', `${(0.5 - y) * 6}deg`);
    });
    vidro.addEventListener('mouseleave', () => {
      vidro.style.setProperty('--inclinacao-x', '0deg');
      vidro.style.setProperty('--inclinacao-y', '0deg');
    });
  }
</script>
