---
/**
 * A SILHUETA DA SERRA — abertura da página "A cidade".
 *
 * A silhueta do horizonte da Mantiqueira vista de Cambuí, traçada à mão a
 * partir do recorte real (não montanha genérica de banco de imagens) — três
 * planos com opacidade decrescente, como serra sob neblina, e um fio carmim
 * marcando a linha do horizonte.
 *
 * Corrigido em 2026-09-11 (era SerraTecida.astro): a versão anterior
 * preenchia a silhueta com um padrão de ponto de tricô, associando a
 * montanha à malharia — que não é a economia de Cambuí (é de Monte Sião e do
 * Circuito das Malhas, município vizinho; ver dados/cidade.ts). A forma da
 * serra é real e específica; a textura de tricô não era.
 *
 * PESO: só três <path> recortados por <clipPath>. SVG embutido no HTML, sem
 * requisição extra, sem canvas, sem biblioteca.
 *
 * MOVIMENTO: um véu da cor do fundo desliza para a direita no primeiro
 * carregamento, revelando a serra. Anima `transform`, no compositor. Com
 * prefers-reduced-motion o véu nem existe (regra em global.css) e a serra
 * aparece inteira e imóvel.
 *
 * ACESSIBILIDADE: é decoração. Fica com aria-hidden e o texto que a acompanha
 * carrega todo o significado — nenhuma informação vive só aqui.
 */
interface Props {
  /** Altura da faixa. A serra é deliberadamente BAIXA: identidade não pode
   *  custar um rolar de tela a quem só quer pagar o IPTU.
   *
   *  O mínimo era 10rem, e no celular o `clamp` travava SEMPRE nele: a 360px
   *  o termo 22vw vale 79px, então a serra ficava fixa em 160px justamente na
   *  tela onde 160px é caro. Medido em 27 de agosto: a 1ª tarefa da home
   *  nascia 277px abaixo da dobra em 360x640. O mínimo agora é 5,5rem — o
   *  termo 22vw volta a mandar do tablet para cima e o desktop não muda
   *  (a 1440px continua batendo no teto de 17rem). */
  altura?: string;
  /** Cor por trás do véu que desliza (e o fundo do próprio wrapper). Só
   *  precisa mudar quando a serra nasce sobre um fundo escuro — index.astro,
   *  desde o degradê de 2026-08-31 — senão o véu revela um retângulo claro
   *  destoando do hero. */
  fundo?: string;
  /** Cor do fio que marca o horizonte. Sobre fundo escuro precisa ser a
   *  variante clara do trigo (--color-carmim-brilho), senão o traço some. */
  acento?: string;
}
const {
  altura = 'clamp(5.5rem, 22vw, 17rem)',
  fundo = 'var(--color-neblina)',
  acento = 'var(--color-carmim)',
} = Astro.props;

/* Perfil da crista, em três planos. Traçado à mão para lembrar o recorte da
   Mantiqueira vista de Cambuí: cristas arredondadas e sobrepostas, não picos
   agudos de montanha alpina. */
const CRISTA_FUNDO =
  'M0 210 C 90 150, 150 168, 232 128 S 372 78, 470 118 C 548 150, 596 122, 690 96 S 852 128, 940 106 C 1032 82, 1104 126, 1198 108 S 1348 74, 1440 104 L1440 320 L0 320 Z';
const CRISTA_MEIO =
  'M0 258 C 104 220, 178 236, 268 200 S 420 160, 528 194 C 618 222, 682 198, 778 176 S 936 208, 1030 190 C 1124 172, 1200 208, 1298 192 S 1392 172, 1440 186 L1440 320 L0 320 Z';
const CRISTA_FRENTE =
  'M0 300 C 120 274, 214 288, 316 262 S 486 232, 606 258 C 706 280, 782 262, 884 246 S 1058 272, 1160 258 C 1258 244, 1338 266, 1440 252 L1440 320 L0 320 Z';
---

<div class="silhueta-serra sem-impressao" style={`--altura-serra:${altura};--fundo-serra:${fundo}`} aria-hidden="true">
  <svg viewBox="0 0 1440 320" preserveAspectRatio="none" role="presentation" focusable="false">
    <defs>
      <!-- Cada plano recorta a mesma crista. -->
      <clipPath id="rec-fundo"><path d={CRISTA_FUNDO} /></clipPath>
      <clipPath id="rec-meio"><path d={CRISTA_MEIO} /></clipPath>
      <clipPath id="rec-frente"><path d={CRISTA_FRENTE} /></clipPath>
    </defs>

    <!-- Plano de fundo: a serra distante, comida pela neblina. -->
    <g clip-path="url(#rec-fundo)">
      <path d={CRISTA_FUNDO} fill="var(--color-serra)" opacity="0.34" />
    </g>

    <!-- Plano do meio. -->
    <g clip-path="url(#rec-meio)">
      <path d={CRISTA_MEIO} fill="var(--color-serra)" opacity="0.72" />
    </g>

    <!-- Plano da frente, e o fio carmim que marca o horizonte: o único acento
         de cor do sistema, aqui usado uma vez só. -->
    <g clip-path="url(#rec-frente)">
      <path d={CRISTA_FRENTE} fill="var(--color-serra-noite)" />
    </g>
    <path d={CRISTA_FRENTE} fill="none" stroke={acento} stroke-width="2.5" />

    <!-- O véu: desliza para a direita revelando a serra. -->
    <rect class="veu" width="1440" height="320" fill={fundo} />
  </svg>
</div>

<style>
  .silhueta-serra {
    height: var(--altura-serra);
    line-height: 0;
    background: var(--fundo-serra);
  }
  .silhueta-serra svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* O gesto de assinatura: 900ms, uma vez, no carregamento. */
  .veu {
    transform-origin: right center;
    animation: revelar var(--duracao-revelar) var(--ease-revelar) forwards;
  }
  @keyframes revelar {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(100%, 0, 0); }
  }
</style>
