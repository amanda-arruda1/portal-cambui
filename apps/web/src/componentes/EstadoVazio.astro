---
/**
 * Mostrado quando uma listagem não tem nada a exibir.
 *
 * Distingue dois casos que parecem iguais na tela mas não são:
 *  - `indisponivel`: o CMS não respondeu ou a coleção ainda não existe. É um
 *    problema nosso, não do cidadão — não prometemos conteúdo que não temos.
 *  - vazio de verdade: a seção existe e ainda não tem publicação.
 *
 * Em nenhum dos dois casos aparece mensagem técnica (stack, host, porta):
 * essa informação vai para o log do servidor, não para a tela pública.
 */
interface Props {
  indisponivel?: boolean;
  assunto: string;
  /** 'documentos publicados' é o padrão; 'perguntas frequentes publicadas'
   *  precisa da concordância no feminino. */
  feminino?: boolean;
}
const { indisponivel = false, assunto, feminino = false } = Astro.props;
---
<div class="vazio">
  <p class="t-sub titulo">
    {indisponivel ? 'Conteúdo temporariamente indisponível' : `Ainda não há ${assunto} publicad${feminino ? 'as' : 'os'}`}
  </p>
  <p class="t-lead texto">
    {
      indisponivel
        ? 'Estamos com uma instabilidade nesta seção. Tente novamente em alguns minutos.'
        : 'Assim que houver publicações, elas aparecerão aqui.'
    }
  </p>
</div>

<style>
  .vazio {
    padding: 2rem;
    border-radius: 4px;
    background: var(--color-papel);
    border-left: 5px solid var(--color-musgo);
  }
  .titulo { color: var(--color-serra); }
  .texto { margin-top: 0.5rem; color: var(--color-musgo); max-width: var(--container-leitura); }
</style>
