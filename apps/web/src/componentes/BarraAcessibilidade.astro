---
/**
 * Barra de acessibilidade — primeira coisa no documento.
 *
 * Reúne o que o eMAG pede e o que portal de governo brasileiro consolidou:
 * atalhos de salto, controle de tamanho de fonte e alto contraste.
 *
 * O Libras SAIU da barra em 2026-09-02, a pedido do usuário. Primeira
 * tentativa criou um botão nosso, com ícone próprio — o usuário corrigiu:
 * era pra sumir do cabeçalho e sobrar só o ícone OFICIAL do governo federal
 * (o que o próprio plugin `vw-access-button` desenha), sem reinventar nada
 * visual. Por isso o plugin agora carrega direto no carregamento da página,
 * e não mais sob demanda atrás de um botão — é o widget do gov.br que fica
 * sempre visível à direita da tela, com a aparência dele mesmo.
 *
 * Fica ANTES do cabeçalho na ordem do DOM, que é a ordem que o leitor de tela
 * e o teclado percorrem. Os atalhos são o primeiro elemento focável da página.
 */
---

<div class="barra sem-impressao">
  <div class="interna">
    <nav aria-label="Atalhos de acessibilidade" class="atalhos">
      <a href="#rodape">Ir para o rodapé</a>
    </nav>

    <div class="controles">
      <div class="grupo" role="group" aria-label="Tamanho do texto">
        <button type="button" data-fonte="menor" class="com-icone" title="Diminuir o tamanho do texto">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 16L7 4L11 16M4.6 11.5H9.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M13.5 10H18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span class="sr-only">Diminuir o tamanho do texto</span>
        </button>
        <button type="button" data-fonte="maior" class="com-icone" title="Aumentar o tamanho do texto">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 16L7 4L11 16M4.6 11.5H9.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M15.75 7.5V12.5M13.5 10H18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span class="sr-only">Aumentar o tamanho do texto</span>
        </button>
      </div>
      <button type="button" data-contraste aria-pressed="false" class="grupo unico com-icone" title="Alto contraste">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="2" />
          <path d="M10 3a7 7 0 0 1 0 14V3z" fill="currentColor" />
        </svg>
        <span class="sr-only">Alto contraste</span>
      </button>
      <button type="button" data-tema-alternar aria-pressed="false" class="grupo unico com-icone" title="Modo escuro">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M17 12.3A7 7 0 0 1 7.7 3 7 7 0 1 0 17 12.3Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="sr-only">Modo escuro</span>
      </button>
    </div>
  </div>
</div>

<!-- Widget oficial do gov.br. Marcação exigida pelo plugin — é o próprio
     plugin quem estiliza `vw-access-button` como o ícone flutuante fixo à
     direita da tela; nada aqui desenha por cima dele. -->
<div {...{ vw: true }} class="enabled sem-impressao">
  <div {...{ "vw-access-button": true }} class="active"></div>
  <div {...{ "vw-plugin-wrapper": true }}><div class="vw-plugin-top-wrapper"></div></div>
</div>

<style>
  .barra {
    background: var(--color-serra-noite);
    /* --color-sobre-escuro, não --color-papel: este fundo não muda com o
       tema (ver a nota em global.css), então o texto também não pode. */
    color: var(--color-sobre-escuro);
    font-size: 0.8125rem;
  }
  .interna {
    max-width: var(--container-carreira);
    margin-inline: auto;
    padding: 0.35rem 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .atalhos { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
  .atalhos a { color: inherit; text-decoration: none; padding: 0.25rem 0; }
  .atalhos a:hover { text-decoration: underline; }
  .controles { display: flex; align-items: center; gap: 0.5rem; }
  .grupo { display: flex; border: 1px solid color-mix(in srgb, currentColor 45%, transparent); border-radius: 4px; overflow: hidden; }
  .grupo button, .grupo.unico {
    background: none;
    color: inherit;
    font: inherit;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
    min-height: 2rem;
  }
  /* Só os botões DENTRO do grupo de fonte não têm borda própria — a borda
     do par inteiro já vem do .grupo pai. O botão único (contraste, tema) É
     o .grupo: precisa manter a borda de 1px herdada dessa regra. */
  .grupo button { border: 0; }
  .grupo button + button { border-left: 1px solid color-mix(in srgb, currentColor 45%, transparent); }
  .grupo button:hover, .grupo.unico:hover { background: color-mix(in srgb, currentColor 18%, transparent); }
  .grupo.unico[aria-pressed='true'] { background: var(--color-carmim); border-color: var(--color-carmim); }
  .com-icone { display: inline-flex; align-items: center; gap: 0.35rem; }
  .com-icone svg { flex: none; }
  /* A barra é escura: o foco branco é o que enxerga sobre ela. */
  .barra :focus-visible { outline-color: var(--color-sobre-escuro); }

  /* Os atalhos só aparecem ao receber foco no celular, onde não cabem. */
  @media (max-width: 47.99rem) {
    .atalhos a { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .atalhos a:focus {
      position: static; width: auto; height: auto; clip: auto;
      background: var(--color-carmim); padding: 0.25rem 0.5rem; border-radius: 3px;
    }
  }
</style>

<script>
  /* Preferências de leitura ficam no navegador de quem usa — nunca no
     servidor. São escolha pessoal, não dado do município. */
  const raiz = document.documentElement;

  const ESCALAS: Record<string, string> = { menor: '0.9', normal: '1', maior: '1.15' };

  function aplicarFonte(chave: string) {
    raiz.style.setProperty('--escala-tipo', ESCALAS[chave] ?? '1');
    try { localStorage.setItem('cambui:fonte', chave); } catch { /* modo privado */ }
  }

  function aplicarContraste(ligado: boolean) {
    raiz.dataset.contraste = ligado ? 'alto' : '';
    document.querySelector<HTMLButtonElement>('button[data-contraste]')?.setAttribute('aria-pressed', String(ligado));
    try { localStorage.setItem('cambui:contraste', ligado ? 'alto' : 'normal'); } catch { /* modo privado */ }
  }

  /* O <script is:inline> no <head> (Base.astro) já decidiu e aplicou o tema
     ANTES da primeira pintura — evita o "flash" de claro em quem prefere
     escuro. Esta função só entra depois: sincroniza o botão com o que já
     está no DOM e grava a escolha quando a pessoa clica. */
  function aplicarTema(escuro: boolean) {
    raiz.dataset.tema = escuro ? 'escuro' : 'claro';
    document.querySelector<HTMLButtonElement>('button[data-tema-alternar]')?.setAttribute('aria-pressed', String(escuro));
    try { localStorage.setItem('cambui:tema', escuro ? 'escuro' : 'claro'); } catch { /* modo privado */ }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-fonte]').forEach((b) =>
    b.addEventListener('click', () => aplicarFonte(b.dataset.fonte!)),
  );
  const botaoContraste = document.querySelector<HTMLButtonElement>('button[data-contraste]');
  botaoContraste?.addEventListener('click', () => {
    aplicarContraste(botaoContraste.getAttribute('aria-pressed') !== 'true');
  });
  const botaoTema = document.querySelector<HTMLButtonElement>('button[data-tema-alternar]');
  botaoTema?.addEventListener('click', () => aplicarTema(raiz.dataset.tema !== 'escuro'));

  try {
    const f = localStorage.getItem('cambui:fonte');
    if (f) aplicarFonte(f);
    if (localStorage.getItem('cambui:contraste') === 'alto') aplicarContraste(true);
  } catch { /* modo privado: segue no padrão */ }

  // Só sincroniza o aria-pressed do botão — o dataset em si já veio certo
  // do script do <head>, escolha do usuário ou preferência do sistema.
  botaoTema?.setAttribute('aria-pressed', String(raiz.dataset.tema === 'escuro'));

  /* VLibras — o ícone oficial do gov.br, carregado direto (não mais atrás
   * de um botão nosso: o usuário pediu só o ícone federal, sem reinvenção
   * visual). Isto reabre o custo medido em 28/08/2026 no Lighthouse — mas é
   * a troca que o usuário escolheu, e o plugin já vem com posição e ícone
   * prontos, então não há CSS nosso a manter em cima dele.
   */

  /* O plugin injeta <img> sem alt. Não dá para corrigir na origem; dá para
   * corrigir aqui. Só o atributo alt — NADA de aria-label em <div> sem papel,
   * que é atributo ARIA proibido e foi a violação que a primeira tentativa
   * de correção criou. */
  function corrigirImagensDoVLibras() {
    const aplicar = () => {
      document.querySelectorAll<HTMLImageElement>('img:not([alt])').forEach((img) => {
        if (img.src.includes('vlibras') || img.id.startsWith('vlibras')) img.setAttribute('alt', '');
      });
    };
    aplicar();
    const observador = new MutationObserver(aplicar);
    observador.observe(document.body, { childList: true, subtree: true });
    setTimeout(() => observador.disconnect(), 20000);
  }

  const s = document.createElement('script');
  s.src = 'https://vlibras.gov.br/app/vlibras-plugin.js';
  s.async = true;
  s.onload = () => {
    // @ts-expect-error — global instalado pelo próprio plugin
    new window.VLibras.Widget('https://vlibras.gov.br/app');
    corrigirImagensDoVLibras();

    // Passar o mouse já abre a caixa de Libras (pedido do usuário). Só na
    // PRIMEIRA vez (`once: true`): o clique do próprio plugin ALTERNA
    // aberto/fechado, então repetir o clique a cada hover fecharia a caixa
    // sempre que o mouse saísse e voltasse — depois do primeiro hover, quem
    // manda é o clique nativo do botão, como sempre funcionou.
    document.querySelector<HTMLElement>('[vw-access-button]')?.addEventListener(
      'mouseenter',
      function abrir() { this.click(); },
      { once: true },
    );
  };
  s.onerror = () => console.error('[libras] o plugin vlibras.gov.br não carregou.');
  document.body.appendChild(s);
</script>
