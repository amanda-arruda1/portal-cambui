---
/**
 * Rodapé.
 *
 * O anti-padrão recusado: cinco colunas de links repetidos e o brasão de novo.
 * O que um rodapé de prefeitura precisa ter é IDENTIFICAÇÃO — quem é o órgão,
 * onde fica, em que horário atende, como se fala com ele. Isso é obrigação
 * legal e é o que o cidadão procura aqui. Navegação já existe no cabeçalho.
 */
import { CNPJ, ENDERECO, EMAIL_CONTATO, HORARIO_ATENDIMENTO, MUNICIPIO, TELEFONES, AUTARQUIAS } from '../dados/instituicional';
import { selos as selosDoCms } from '../lib/conteudo';
import { arquivo } from '../lib/directus';

const ano = new Date().getFullYear();

/* Faixa de confiança: some inteira sem selo cadastrado, nunca aparece com um
   texto de "em publicação" — rodapé não é lugar de placeholder pedindo
   desculpa por um dado que ainda não existe. */
const { dados: selos } = await selosDoCms();
---

<footer id="rodape" class="rodape sobre-serra">
  <div class="carreira">
    <div class="ourela">
      <span class="fio fio-ourela" aria-hidden="true"></span>
      <div class="corpo">
        <div class="grade">
          <div class="identificacao">
            <p class="nome">{MUNICIPIO.nomeCompleto}</p>

            {ENDERECO ? (
              <address class="endereco">
                {ENDERECO.logradouro}, {ENDERECO.numero} — {ENDERECO.bairro}<br />
                {ENDERECO.cidade}/{ENDERECO.uf} — CEP {ENDERECO.cep}
              </address>
            ) : (
              <p class="pendente">Endereço em publicação.</p>
            )}

            {TELEFONES.length > 0 && (
              <p class="contatos">
                {TELEFONES.map((t) => (
                  <a href={`tel:+55${t.numero.replace(/\D/g, '')}`}><span class="fio-foco">{t.numero}</span></a>
                ))}
              </p>
            )}
            {EMAIL_CONTATO && <p class="contatos"><a href={`mailto:${EMAIL_CONTATO}`}><span class="fio-foco">{EMAIL_CONTATO}</span></a></p>}
            {HORARIO_ATENDIMENTO && <p class="horario">{HORARIO_ATENDIMENTO}</p>}
            <p class="cnpj">{CNPJ ? `CNPJ ${CNPJ}` : 'CNPJ em publicação.'}</p>
          </div>

          <div class="colunas">
            <div>
              <h2 class="t-rotulo">Acesso à informação</h2>
              <ul>
                <li><a href="/diario-oficial"><span class="fio-foco">Diário Oficial Eletrônico</span></a></li>
                <li><a href="/diario-oficial/autenticidade"><span class="fio-foco">Conferir autenticidade de documento</span></a></li>
                <li><a href="/transparencia"><span class="fio-foco">Portal da Transparência</span></a></li>
                <li><a href="http://cambui.eouve.com.br/" target="_blank" rel="noopener noreferrer"><span class="fio-foco">Ouvidoria e e-SIC</span></a></li>
                <li><a href="/documentos"><span class="fio-foco">Editais e licitações</span></a></li>
                <li><a href="/perguntas-frequentes"><span class="fio-foco">Perguntas frequentes</span></a></li>
                <li><a href="/telefones"><span class="fio-foco">Telefones úteis</span></a></li>
              </ul>
            </div>

            <div>
              <h2 class="t-rotulo">Autarquias</h2>
              <ul>
                {AUTARQUIAS.map((a) => (
                  <li>
                    <a href={a.url} target="_blank" rel="noopener noreferrer">
                      <span class="fio-foco">{a.sigla}</span> <span class="secundario">— {a.nome}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        {selos.length > 0 && (
          <div class="selos">
            <h2 class="t-rotulo">Selos e certificações</h2>
            <ul>
              {selos.map((s) => (
                <li>
                  <a href="/transparencia#selos" title={`${s.nome} — ${s.orgao_emissor}`}>
                    {s.imagem ? (
                      <img
                        src={arquivo(s.imagem, { width: 96, height: 96, fit: 'contain', format: 'webp' })!}
                        alt={s.nome}
                        width="48"
                        height="48"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="sem-imagem">{s.nome}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="rodape-fim">
          <p>© {ano} {MUNICIPIO.nomeCompleto}</p>
          <nav aria-label="Informações legais">
            <a href="/acessibilidade"><span class="fio-foco">Acessibilidade</span></a>
            <a href="/privacidade"><span class="fio-foco">Privacidade e cookies</span></a>
            <a href="/contato"><span class="fio-foco">Fale conosco</span></a>
          </nav>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .rodape {
    background: var(--color-serra-noite);
    /* --color-sobre-escuro, não --color-papel: este fundo não muda com o
       tema (ver a nota em global.css), então o texto também não pode. */
    color: var(--color-sobre-escuro);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    margin-top: auto;
  }
  /* Vence a regra global `.sobre-serra :focus-visible` — precisa, porque o
     fundo daqui não muda de tom no modo escuro. */
  .rodape :focus-visible { outline-color: var(--color-sobre-escuro); }
  .rodape a { color: inherit; text-decoration: none; }
  .fio { filter: invert(1) brightness(2); opacity: 0.45; min-height: 4rem; }

  .grade { display: grid; gap: 2.5rem; }
  @media (min-width: 48rem) { .grade { grid-template-columns: 1.2fr 1fr; gap: 3rem; } }

  .nome { font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em; }
  .endereco { font-style: normal; margin-top: 0.75rem; line-height: 1.6; }
  .contatos { margin-top: 0.5rem; font-weight: 600; }
  .horario { margin-top: 0.5rem; }
  .cnpj, .pendente { margin-top: 0.75rem; font-size: 0.875rem; opacity: 0.8; }

  .colunas { display: grid; gap: 2rem; }
  @media (min-width: 30rem) { .colunas { grid-template-columns: 1fr 1fr; } }
  .colunas h2 { opacity: 0.75; }
  .colunas ul { list-style: none; margin: 0.7rem 0 0; padding: 0; display: grid; gap: 0.5rem; }
  .colunas li { line-height: 1.4; }
  .secundario { opacity: 0.7; font-size: 0.875rem; }

  .selos {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid color-mix(in srgb, var(--color-sobre-escuro) 18%, transparent);
  }
  .selos h2 { opacity: 0.75; }
  .selos ul { list-style: none; margin: 0.9rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1rem; }
  .selos a {
    display: flex; align-items: center; justify-content: center;
    width: 3.5rem; height: 3.5rem; border-radius: 8px;
    background: color-mix(in srgb, var(--color-sobre-escuro) 10%, transparent);
    padding: 0.5rem;
  }
  .selos a:hover { background: color-mix(in srgb, var(--color-sobre-escuro) 18%, transparent); }
  .selos img { max-width: 100%; max-height: 100%; display: block; }
  .selos .sem-imagem { font-size: 0.6875rem; text-align: center; line-height: 1.2; opacity: 0.85; }

  .rodape-fim {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-sobre-escuro) 25%, transparent);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    font-size: 0.875rem;
  }
  .rodape-fim nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
</style>
