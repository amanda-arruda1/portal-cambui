# Segredos — NUNCA versionar
.env
.env.*
!.env.example
!.env.web.example
*.pem
*.key
*.crt
secrets/

# Dependências e build
node_modules/
dist/
.astro/
.output/
build/

# Dados de runtime (volumes, uploads, dumps)
data/
uploads/
backups/
*.sql
*.dump
# ...mas SQL que é CÓDIGO precisa ser versionado. A regra `*.sql` existe para
# dump e backup; gatilho, índice e migração são fonte.
!infra/docker/postgres/initdb/*.sql
!infra/directus/**/*.sql

# Logs e temporários
*.log
logs/
tmp/
.DS_Store
