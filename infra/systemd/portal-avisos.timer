# A cada 5 minutos.
#
# Por que 5 e não 1: o e-mail de confirmação é o único envio que a pessoa fica
# esperando na tela, e "poucos minutos" é o que a página promete. Por que não
# 15: quinze minutos esperando um link de confirmação é onde o cadastro se
# perde.

[Unit]
Description=Entrega dos avisos de licitacao a cada 5 minutos
Documentation=file:///opt/portal-cambui/ARQUITETURA.md

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
# Espalha o disparo para não coincidir com outros timers do sistema.
RandomizedDelaySec=45
AccuracySec=30s
Persistent=true
Unit=portal-avisos.service

[Install]
WantedBy=timers.target
