# Portal Cambuí — TLS NA ORIGEM (opcional).
#
# ARQUIVO INATIVO. Só passa a valer quando renomeado para 20-https.conf, o que
# o 05-certificado.sh faz após instalar o par de chaves. Ativá-lo antes impede
# o Nginx de iniciar: ele aponta para certificados que ainda não existem.
#
# QUANDO ISTO É NECESSÁRIO:
#   O cidadão JÁ navega em https — a Cloudflare termina o TLS na borda. Este
#   arquivo cobre o outro trecho: Cloudflare/proxy -> esta VM, hoje em texto
#   claro dentro da rede do município. Ativar isto é o que permite pôr a
#   Cloudflare em modo "Full (strict)", em vez de "Flexible".
#
#   Depende de duas coisas que ainda NÃO estão confirmadas:
#     1. o proxy 10.180.0.13 encaminhar a 443 até aqui (hoje só manda a 80);
#     2. a 443 liberada no firewalld para esse IP (o 04 faz, se pedido).
#
# ORIGEM DO CERTIFICADO: os caminhos abaixo são neutros de propósito. Serve
# tanto um Cloudflare Origin Certificate quanto um Let's Encrypt por DNS-01 —
# o 05-certificado.sh popula /etc/nginx/ssl/origem/ nos dois casos.

# Host desconhecido batendo na 443: recusa o handshake, sem revelar nada.
server {
    listen      443 ssl default_server;
    listen      [::]:443 ssl default_server;
    http2       on;
    server_name _;
    ssl_reject_handshake on;
}

# --- Apex: só redireciona para o www ---
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name prefeituradecambui.mg.gov.br;

    ssl_certificate     /etc/nginx/ssl/origem/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/origem/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    return 301 https://www.prefeituradecambui.mg.gov.br$request_uri;
}

# --- Portal público (Astro SSR) ---
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name www.prefeituradecambui.mg.gov.br;

    ssl_certificate     /etc/nginx/ssl/origem/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/origem/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    # HSTS: NÃO ativar aqui. Quem fala com o navegador é a Cloudflare — o
    # cabeçalho tem de sair de lá. Emitido nesta origem, ele nem chega ao
    # cidadão, e se chegar é por caminho que não controlamos.

    include /etc/nginx/snippets/site-publico.conf;
}

# --- Painel administrativo (Directus) ---
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name admin.prefeituradecambui.mg.gov.br;

    ssl_certificate     /etc/nginx/ssl/origem/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/origem/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    include /etc/nginx/snippets/site-admin.conf;
}
