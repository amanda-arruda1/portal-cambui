# Portal Cambuí — variáveis do frontend (Astro SSR).
# Copiar para .env.web (chmod 640, dono root:portal-web). NUNCA versionar.
#
# Deliberadamente separado do .env geral: o processo web não tem motivo para
# enxergar as chaves dos serviços periódicos.

# URL pública, usada em canonical, Open Graph e sitemap.
PUBLIC_SITE_URL=https://www.prefeituradecambui.mg.gov.br

# O Payload responde em 127.0.0.1:3000, sob /cms.
PAYLOAD_INTERNAL_URL=http://127.0.0.1:3000/cms

# Chave da conta de serviço dos avisos do portal (cadastro, confirmação, descadastro).
# Gerada por novo-cms-payload/scripts/criar-usuarios-servico-avisos.ts — NUNCA versionar o valor real.
PAYLOAD_TOKEN_AVISOS=

# Liga os Globals do Payload (textos, menu, links). Ausente = o site usa só os valores de reserva do código.
CMS_GLOBAIS=payload
