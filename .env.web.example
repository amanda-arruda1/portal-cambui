# Portal Cambuí — variáveis do frontend (Astro SSR).
# Copiar para .env.web (chmod 640, dono root:portal-web). NUNCA versionar.
#
# Deliberadamente separado do .env geral: o processo web não tem motivo para
# enxergar a senha do Postgres nem as chaves do Directus.

# URL pública, usada em canonical, Open Graph e sitemap.
PUBLIC_SITE_URL=https://www.prefeituradecambui.mg.gov.br

# O Directus publica em 127.0.0.1:8055 no próprio host.
DIRECTUS_INTERNAL_URL=http://127.0.0.1:8055

# Opcional. Vazio = o portal lê pelo papel público do Directus, que é o
# caminho normal. Só preencher se a prefeitura optar por fechar a leitura
# pública e servir o conteúdo exclusivamente pela aplicação.
DIRECTUS_TOKEN=

# Token de serviço dos avisos de licitação. Gerado por
# infra/directus/licitacoes/aplicar-avisos.mjs — NUNCA versionar o valor real.
DIRECTUS_TOKEN_AVISOS=
