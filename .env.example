# Portal Cambuí — modelo de variáveis de ambiente
# Copiar para .env (chmod 600) e preencher. NUNCA versionar o .env.
# Gerar segredos com: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40

# --- PostgreSQL ---
POSTGRES_DB=portal_cambui
POSTGRES_USER=portal_cambui
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Directus ---
DIRECTUS_KEY=
DIRECTUS_SECRET=
# O primeiro boot cria o administrador com este endereço. Deixar VAZIO enquanto
# o e-mail institucional não estiver definido: o Directus sobe normalmente e
# apenas não cria usuário nenhum. Nunca preencher com endereço fictício.
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
DIRECTUS_PUBLIC_URL=https://admin.prefeituradecambui.mg.gov.br

# --- Astro (SSR) ---
PUBLIC_SITE_URL=https://www.prefeituradecambui.mg.gov.br
# O Astro roda no host (Node 22), então alcança o Directus pelo loopback.
DIRECTUS_INTERNAL_URL=http://127.0.0.1:8055

# --- SMTP (SMTP2GO, via TrustIT) ---
# O envio NÃO sai pelo servidor de caixa postal do município (aquele exige a
# senha de uma caixa e recusa relay de terceiros com 530). Sai por um relay
# transacional, que é o certo para envio automático: reputação de IP separada,
# fila e rastreamento próprios.
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=

# --- Avisos de licitação por e-mail ---
# Endereço que aparece no "De:".
#
# ATENÇÃO — NÃO usar @prefeituradecambui.mg.gov.br aqui sem antes mexer no DNS.
# O SPF do município é "v=spf1 include:spf.m9.network -all", e spf.m9.network é
# uma lista fixa de IPs que NÃO inclui o SMTP2GO: sair como o domínio da
# prefeitura por este relay falha o SPF de forma rígida e a mensagem é
# descartada no destino. Já mailprotect.com.br tem include:spf.smtp2go.com.
#
# Para poder usar o domínio do município: acrescentar include:spf.smtp2go.com
# ao SPF de prefeituradecambui.mg.gov.br e configurar o DKIM no painel do
# SMTP2GO. O nome de exibição já é "Prefeitura Municipal de Cambuí".
AVISOS_REMETENTE=
# Opcional: para onde vai a resposta de quem responder ao aviso. Sem isto, as
# respostas caem no remetente — que costuma ser caixa sem dono.
AVISOS_RESPONDER_PARA=
# Token do serviço de entrega. Gerado por
# infra/directus/licitacoes/aplicar-avisos.mjs — NUNCA versionar o valor real.
AVISOS_TOKEN_ENTREGA=

# --- Indicadores econômicos (IPCA, Selic, CDI, Dólar) ---
# Token do portal-indicadores.service — o único processo que sai para a
# internet para consultar BCB/AwesomeAPI; o portal-web continua com
# IPAddressDeny=any. Gerado por infra/directus/indicadores/aplicar.mjs —
# NUNCA versionar o valor real.
INDICADORES_TOKEN=

# --- Previsão do tempo (Cambuí/MG, via Open-Meteo) ---
# Token do portal-tempo.service — o único processo que sai para a internet
# para consultar a Open-Meteo; o portal-web continua com IPAddressDeny=any.
# Gerado por infra/directus/tempo/aplicar.mjs — NUNCA versionar o valor real.
TEMPO_TOKEN=
